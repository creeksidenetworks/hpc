# =============================================================================
# Secrets and credentials — never commit these
# =============================================================================

# MariaDB passwords
docker/.env

# IPA bind credentials (use ipa.conf.sample as reference)
docker/ipa/ipa.conf

# Munge shared secret
docker/munge/

# Slurmdbd DB password (StoragePass)
# docker/slurm/conf/slurmdbd.conf

# OOD portal config — contains OIDC client secret (use ood_portal.yml.sample)
docker/ondemand/conf/ood_portal.yml
docker/ondemand/apps

# SSSD configs — contain LDAP bind password (use sssd.conf.sample)
docker/ondemand/conf/sssd.conf
docker/slurm/conf/sssd.conf
docker/slurm/conf/ldap.conf
docker/slurm/conf/slurmdbd.conf

# FreeIPA CA certificate (site-specific, fetch from IPA server)
docker/ipa/ca.crt

# =============================================================================
# Generated / runtime files
# =============================================================================
*.log
*.pid
*.out

# =============================================================================
# Legacy / local paths (pre-existing)
# =============================================================================
hpc-on-docker/
instruction.md
conf/hpc.conf

# =============================================================================
# Editor and OS noise
# =============================================================================
.DS_Store
*.swp
*.swo
*~
.claude/
