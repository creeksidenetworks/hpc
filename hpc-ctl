#!/bin/bash
#===============================================================================
# hpc-ctl - Open OnDemand HPC Server Setup Script
# Platform : Rocky Linux 8 AMD64
# Author   : Generated for Creekside Networks HPC
#
# Commands:
#   install [-c <conf_dir>]       Install Open OnDemand HPC server
#   cpn -add    <hostname|ip>     Add a compute node to the cluster
#   cpn -remove <hostname|ip>     Remove a compute node from the cluster
#   update                        Sync cluster nodes from conf/cluster.conf
#===============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_CONF_DIR="${SCRIPT_DIR}/conf"
CONF_DIR="${DEFAULT_CONF_DIR}"
LOG_FILE="/var/log/hpc-ctl.log"

# Default versions (overridable from hpc.conf)
ONDEMAND_VERSION="4.1"
SLURM_VERSION="20.11.9"
MARIADB_VERSION="10.11"
XPRA_VERSION="6"

# Console colours
Red=$(tput setaf 1); Green=$(tput setaf 2); Yellow=$(tput setaf 3)
Blue=$(tput setaf 4); Cyan=$(tput setaf 6)
Bold=$(tput bold); Reset=$(tput sgr0); Dim=$(tput dim)

print_ok()    { echo -e "  ${Green}✓${Reset} $*" | tee -a "$LOG_FILE"; }
print_warn()  { echo -e "  ${Yellow}⚠${Reset} $*" | tee -a "$LOG_FILE"; }
print_error() { echo -e "  ${Red}✗${Reset} $*" | tee -a "$LOG_FILE"; }
print_info()  { echo -e "  ${Blue}ℹ${Reset} $*" | tee -a "$LOG_FILE"; }
print_step()  {
    echo ""
    echo -e "${Yellow}▶${Reset} ${Bold}$*${Reset}"
    echo -e "${Dim}$(printf '─%.0s' $(seq 1 50))${Reset}"
}

# Keep log_* as aliases so all existing call sites continue to work
log_info()  { print_ok "$*"; }
log_warn()  { print_warn "$*"; }
log_error() { print_error "$*"; }
log_step()  { print_step "$*"; }
die()       { print_error "$*"; exit 1; }

usage() {
    cat <<EOF
Usage: $0 <command> [options]

Commands:
  install [-c <conf_dir>]       Install Open OnDemand HPC server
  restart                       Restart all services and refresh OOD sessions
  status                        Show status of services, nodes, jobs, and apps
  cpn -add    <hostname|ip>     Add a compute node to the cluster
  cpn -remove <hostname|ip>     Remove a compute node from the cluster
  update                        Sync cluster nodes from conf/cluster.conf

Options:
  -c <conf_dir>   Path to configuration directory (default: ./conf)

Examples:
  $0 install
  $0 install -c /etc/hpc/conf
  $0 cpn -add cpn01.example.com
  $0 cpn -remove cpn02.example.com
  $0 update
EOF
}

#-------------------------------------------------------------------------------
# load_config: source hpc.conf; create example files and exit if missing
#-------------------------------------------------------------------------------
load_config() {
    local conf_file="${CONF_DIR}/hpc.conf"
    if [[ ! -f "$conf_file" ]]; then
        create_example_conf
        echo ""
        log_error "Config file not found: $conf_file"
        log_error "Example configuration files have been created in: ${CONF_DIR}"
        log_error "Please update them and re-run this script."
        exit 1
    fi

    # shellcheck source=/dev/null
    source "$conf_file"

    # Required variables — collect all missing ones before dying
    local required_vars=(
        CLUSTER_NAME SERVER_FQDN PROXY_FQDN
        IPA_SERVER IPA_DOMAIN IPA_BASE_DN
        OIDC_PROVIDER_METADATA_URL OIDC_CLIENT_ID OIDC_CLIENT_SECRET
    )
    local missing_vars=()
    for var in "${required_vars[@]}"; do
        [[ -z "${!var:-}" ]] && missing_vars+=("$var")
    done
    if [[ ${#missing_vars[@]} -gt 0 ]]; then
        log_error "The following required variables are not set in $conf_file:"
        for var in "${missing_vars[@]}"; do
            log_error "  - $var"
        done
        log_error "Please set the above variables and re-run this script."
        exit 1
    fi

    # Apply defaults
    ONDEMAND_PORT="${ONDEMAND_PORT:-8443}"
    OIDC_SCOPE="${OIDC_SCOPE:-openid profile email}"
    OIDC_REMOTE_USER_CLAIM="${OIDC_REMOTE_USER_CLAIM:-preferred_username}"
    IPA_USER_BASE="${IPA_USER_BASE:-cn=users,cn=accounts,${IPA_BASE_DN}}"
    IPA_GROUP_BASE="${IPA_GROUP_BASE:-cn=groups,cn=accounts,${IPA_BASE_DN}}"
    IPA_HPC_GROUP="${IPA_HPC_GROUP:-hpc-users}"
    MARIADB_SLURM_PASS="${MARIADB_SLURM_PASS:-}"
    CLIPBOARD="${CLIPBOARD:-disabled}"
    FILE="${FILE:-upload}"

    log_info "Config loaded from: $conf_file"
}

#-------------------------------------------------------------------------------
# create_example_conf: write sample conf files so the user can fill them in
#-------------------------------------------------------------------------------
create_example_conf() {
    mkdir -p "${CONF_DIR}"

    if [[ ! -f "${CONF_DIR}/hpc.conf" ]]; then
        cat > "${CONF_DIR}/hpc.conf" <<'EOF'
# Package versions
ONDEMAND_VERSION="4.1"
SLURM_VERSION="20.11.9"
MARIADB_VERSION="10.11"
XPRA_VERSION="6"

# HPC cluster identity
CLUSTER_NAME="HPC"
SERVER_FQDN="hpc.example.com"
PROXY_FQDN="hpc.example.com"
ONDEMAND_PORT=8443

# FreeIPA configuration
IPA_SERVER=ipa.example.com
IPA_DOMAIN=example.com
IPA_BASE_DN=dc=example,dc=com
IPA_USER_BASE=cn=users,cn=accounts,dc=example,dc=com
IPA_GROUP_BASE=cn=groups,cn=accounts,dc=example,dc=com
IPA_BIND_DN=uid=ldapauth,cn=sysaccounts,cn=etc,dc=example,dc=com
IPA_BIND_PASSWORD=changeme
IPA_HPC_GROUP=hpc-users

# OIDC authentication
# Microsoft Entra ID (Azure AD):
#   OIDC_PROVIDER_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# Keycloak:
#   OIDC_PROVIDER_METADATA_URL=https://keycloak.example.com/realms/<realm>/.well-known/openid-configuration
OIDC_PROVIDER_METADATA_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0/.well-known/openid-configuration
OIDC_CLIENT_ID=YOUR-CLIENT-ID
OIDC_CLIENT_SECRET=YOUR-CLIENT-SECRET

# JWT claim mapped to POSIX username.
# Append regex to extract a sub-match (e.g. strip domain from UPNs).
OIDC_REMOTE_USER_CLAIM="preferred_username ^([^@]+)"
OIDC_SCOPE="openid profile email"

# MariaDB password for Slurm accounting DB (auto-generated if left blank)
MARIADB_SLURM_PASS=

# Global configuration
# Set clipboard share option:
#  - disabled (default), no clipboard share
#  - copy, allow both copy and paste from/to server
#  - paste, allow paste only to server
CLIPBOARD=disabled

# File operations
# Enable file upload and download
#   - upload, upload enabled only (default)
#   - download, enable download and upload
#   - disabled, disable both upload and download
FILE=upload
EOF
        echo "[INFO]  Created example: ${CONF_DIR}/hpc.conf"
    fi

    if [[ ! -f "${CONF_DIR}/cluster.conf" ]]; then
        cat > "${CONF_DIR}/cluster.conf" <<'EOF'
# Compute nodes - one hostname or IP per line.
# This server (localhost) is registered automatically on first install.
localhost       # this server
#cpn01.example.com
#cpn02.example.com
EOF
        echo "[INFO]  Created example: ${CONF_DIR}/cluster.conf"
    fi

    if [[ ! -f "${CONF_DIR}/apps.conf" ]]; then
        cat > "${CONF_DIR}/apps.conf" <<'EOF'
# Applications listed in Interactive Apps -> Applications menu.
# One binary name per line (must be available in PATH on compute nodes).
google-chrome
gtkwave
EOF
        echo "[INFO]  Created example: ${CONF_DIR}/apps.conf"
    fi
}

#-------------------------------------------------------------------------------
# Preflight checks
#-------------------------------------------------------------------------------
check_root() {
    [[ $EUID -eq 0 ]] || die "This script must be run as root."
}

check_ipa_joined() {
    log_step "Checking FreeIPA membership..."
    # Use realm list (no Kerberos ticket required) to verify domain enrollment.
    if ! realm list 2>/dev/null | grep -qi "domain-name:.*${IPA_DOMAIN}"; then
        log_warn "This server is not joined to FreeIPA."
        log_warn "Join with: ipa-client-install --server=${IPA_SERVER} --domain=${IPA_DOMAIN}"
        log_warn "Then re-run this script."
        exit 1
    fi
    log_info "FreeIPA membership confirmed (domain: ${IPA_DOMAIN})."
}

#-------------------------------------------------------------------------------
# disable_selinux: check SELinux state and disable if active
#-------------------------------------------------------------------------------
disable_selinux() {
    local selinux_status
    selinux_status=$(getenforce 2>/dev/null || echo "Disabled")
    case "$selinux_status" in
        Enforcing|Permissive)
            log_step "Disabling SELinux (currently: ${selinux_status})..."
            setenforce 0 2>/dev/null || true
            if [[ -f /etc/selinux/config ]]; then
                sed -i 's/^SELINUX=.*/SELINUX=disabled/' /etc/selinux/config
            fi
            log_info "SELinux disabled (effective immediately; persistent after reboot)."
            ;;
        *)
            log_info "SELinux is already disabled."
            ;;
    esac
    # When SELinux is disabled the RPM selinux plugin has no context files to
    # read and will abort any transaction.  Tell DNF/RPM to skip file-context
    # labelling for the rest of this session.
    export DNF_FLAGS_EXTRA="--setopt=tsflags=nocontexts"
}

#-------------------------------------------------------------------------------
# _pkg / _grp: quiet install helpers — one result line per call
#   -o  optional: print WARN instead of dying on failure
#-------------------------------------------------------------------------------
_pkg() {
    local optional=false
    [[ "${1:-}" == "-o" ]] && { optional=true; shift; }
    local label="$1"; shift
    # Skip if all packages are already installed
    local all_installed=true
    for pkg in "$@"; do
        rpm -q "$pkg" &>/dev/null || { all_installed=false; break; }
    done
    if $all_installed; then
        print_ok "$label (already installed)"
        return 0
    fi
    # shellcheck disable=SC2086
    if dnf install -y ${DNF_FLAGS_EXTRA:-} "$@" &>>"$LOG_FILE"; then
        print_ok "$label"
    elif $optional; then
        print_warn "$label"
    else
        print_error "$label"
        die "Package installation failed: $label"
    fi
}

_grp() {
    local optional=false
    [[ "${1:-}" == "-o" ]] && { optional=true; shift; }
    local label="$1"
    # Skip if group is already installed
    if dnf group list installed 2>/dev/null | grep -qi "^[[:space:]]*${label}$"; then
        print_ok "group: $label (already installed)"
        return 0
    fi
    # shellcheck disable=SC2086
    if dnf groupinstall -y ${DNF_FLAGS_EXTRA:-} "$label" &>>"$LOG_FILE"; then
        print_ok "group: $label"
    elif $optional; then
        print_warn "group: $label"
    else
        print_error "group: $label"
        die "Group installation failed: $label"
    fi
}

#-------------------------------------------------------------------------------
# setup_slurm_user: create slurm system user at uid/gid 1000
#-------------------------------------------------------------------------------
setup_slurm_user() {
    log_step "Setting up slurm system user (uid=1000, gid=1000)..."

    # GID 1000
    if getent group 1000 &>/dev/null; then
        local g; g=$(getent group 1000 | cut -d: -f1)
        if [[ "$g" != "slurm" ]]; then
            log_warn "GID 1000 occupied by group '$g'. Removing it."
            groupdel "$g" || true
        fi
    fi
    if getent group slurm &>/dev/null; then
        local existing_gid; existing_gid=$(getent group slurm | cut -d: -f3)
        if [[ "$existing_gid" != "1000" ]]; then
            log_warn "Group 'slurm' has GID $existing_gid (expected 1000). Recreating."
            groupdel slurm || true
        fi
    fi
    getent group slurm &>/dev/null || groupadd -r --gid=1000 slurm

    # UID 1000
    if getent passwd 1000 &>/dev/null; then
        local u; u=$(getent passwd 1000 | cut -d: -f1)
        if [[ "$u" != "slurm" ]]; then
            log_warn "UID 1000 occupied by user '$u'. Removing it."
            userdel -r "$u" 2>/dev/null || true
        fi
    fi
    if getent passwd slurm &>/dev/null; then
        local existing_uid; existing_uid=$(getent passwd slurm | cut -d: -f3)
        if [[ "$existing_uid" != "1000" ]]; then
            log_warn "User 'slurm' has UID $existing_uid (expected 1000). Recreating."
            userdel -r slurm 2>/dev/null || true
        fi
    fi
    getent passwd slurm &>/dev/null || \
        useradd -r -g slurm --uid=1000 -s /sbin/nologin -d /var/lib/slurm slurm

    log_info "Slurm user ready: uid=$(id -u slurm) gid=$(id -g slurm)"
}

#-------------------------------------------------------------------------------
# install_repos: enable EPEL, PowerTools, OOD, Xpra, MariaDB repos
#-------------------------------------------------------------------------------
install_repos() {
    log_step "Configuring package repositories..."

    # EPEL
    # shellcheck disable=SC2086
    { dnf install -y ${DNF_FLAGS_EXTRA:-} epel-release &>>"$LOG_FILE" || \
      dnf install -y ${DNF_FLAGS_EXTRA:-} "https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm" &>>"$LOG_FILE"; } \
        && print_ok "epel-release" || { print_error "epel-release"; die "EPEL install failed."; }

    # PowerTools (CRB)
    _pkg "dnf-plugins-core" dnf-plugins-core
    { dnf config-manager --set-enabled powertools &>>"$LOG_FILE" || \
      dnf config-manager --set-enabled crb &>>"$LOG_FILE" || true; } \
        && print_ok "powertools/crb"

    yes | rpm --import https://yum.osc.edu/ondemand/RPM-GPG-KEY-ondemand-SHA512 &>>"$LOG_FILE" || true

    # Open OnDemand repo
    if rpm -q ondemand-release &>/dev/null; then
        print_ok "ondemand-release-${ONDEMAND_VERSION} (already installed)"
    else
        local _os_major
        _os_major=$(. /etc/os-release && echo "${VERSION_ID%%.*}")
        # shellcheck disable=SC2086
        yes | dnf install -y ${DNF_FLAGS_EXTRA:-} \
            "https://yum.osc.edu/ondemand/${ONDEMAND_VERSION}/ondemand-release-web-${ONDEMAND_VERSION}-1.el${_os_major}.noarch.rpm" \
            &>>"$LOG_FILE" \
            && print_ok "ondemand-release-${ONDEMAND_VERSION}" || print_warn "ondemand-release-${ONDEMAND_VERSION}"
    fi
    
    # Xpra repo
    curl -fsSL \
        https://raw.githubusercontent.com/Xpra-org/xpra/master/packaging/repos/rockylinux/xpra.repo \
        -o /etc/yum.repos.d/xpra.repo &>>"$LOG_FILE" \
        && print_ok "xpra-${XPRA_VERSION} repo" || print_warn "xpra-${XPRA_VERSION} repo"

    # MariaDB repo
    cat > /etc/yum.repos.d/mariadb.repo <<EOF
[mariadb]
name = MariaDB ${MARIADB_VERSION}
baseurl = https://downloads.mariadb.com/MariaDB/mariadb-${MARIADB_VERSION}/yum/rhel/8/x86_64
gpgkey = https://downloads.mariadb.com/MariaDB/RPM-GPG-KEY-MariaDB
gpgcheck = 1
enabled = 1
EOF
    print_ok "mariadb-${MARIADB_VERSION} repo"

    # Google Chrome repo
    cat > /etc/yum.repos.d/google-chrome.repo <<'EOF'
[google-chrome]
name=google-chrome
baseurl=http://dl.google.com/linux/chrome/rpm/stable/x86_64
enabled=1
gpgcheck=1
gpgkey=https://dl.google.com/linux/linux_signing_key.pub
EOF
    print_ok "google-chrome repo"

    # VS Code repo
    cat > /etc/yum.repos.d/vscode.repo <<'EOF'
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
EOF
    print_ok "vscode repo"

    # Refresh metadata
    #dnf makecache &>>"$LOG_FILE" && print_ok "dnf makecache" || print_warn "dnf makecache"
}

#-------------------------------------------------------------------------------
# install_packages: install all required system packages
#-------------------------------------------------------------------------------
install_packages() {
    log_step "Installing system packages..."

    # Development tools (needed to compile Slurm)
    _grp "Development Tools"

    # Xfce desktop — optional; warn if incomplete
    _grp -o "Xfce"

    # Disable conflicting AppStream MariaDB/MySQL modules before installing
    # from the official MariaDB repo (Rocky 8 ships mariadb:10.3/10.5 via AppStream)
    dnf module disable -y mariadb mysql &>>"$LOG_FILE" 2>&1 || true
    print_ok "disable module: mariadb mysql"

    # MariaDB — with --allowerasing to replace any conflicting AppStream packages
    _pkg "MariaDB-server MariaDB-client MariaDB-devel" \
        --allowerasing MariaDB-server MariaDB-client MariaDB-devel

    # Core utilities
    _pkg "wget curl git vim bzip2" wget curl git vim bzip2

    # Munge authentication
    _pkg "munge munge-devel munge-libs" munge munge-devel munge-libs

    # Python 3.9
    _pkg "python39 python39-devel python39-pip python3-numpy" \
        python39 python39-devel python39-pip python3-numpy

    # System tools
    _pkg "pcp" pcp
    _pkg "nmap-ncat" nmap-ncat
    _pkg "cronie" cronie
    _pkg "openssh-server sshpass" openssh-server sshpass
    _pkg "xauth xterm" xauth xterm
    _pkg "mod_auth_openidc" mod_auth_openidc
    _pkg "lua" lua

    # SSSD / FreeIPA integration
    _pkg "sssd sssd-ipa sssd-tools" sssd sssd-ipa sssd-tools
    _pkg "oddjob oddjob-mkhomedir" oddjob oddjob-mkhomedir

    # Optional GUI / EDA applications
    # gtkwave requires Judy which is in AppStream but hidden by modular filtering;
    # install Judy directly from the Rocky mirror RPM to unblock gtkwave.
    if ! rpm -q Judy &>/dev/null; then
        local judy_rpm="/tmp/Judy.rpm"
        local judy_url="https://dl.rockylinux.org/pub/rocky/8/AppStream/x86_64/os/Packages/j/Judy-1.0.5-18.module+el8.10.0+1674+fa55eae9.x86_64.rpm"
        if curl -fL "${judy_url}" -o "${judy_rpm}" &>>"$LOG_FILE" && \
           rpm -ivh --noplugins "${judy_rpm}" &>>"$LOG_FILE"; then
            print_ok "Judy (gtkwave dependency)"
        else
            print_warn "Judy (gtkwave dependency) — gtkwave may not install"
        fi
        rm -f "${judy_rpm}" 2>/dev/null || true
    fi
    _pkg -o "gtkwave" gtkwave
    _pkg -o "google-chrome-stable" google-chrome-stable
    _pkg -o "libreoffice" libreoffice
    _pkg -o "code (VS Code)" code
    _pkg -o "firefox gnome-terminal xfce4-terminal openbox xdotool wmctrl" \
        firefox gnome-terminal xfce4-terminal openbox xdotool wmctrl

    # Xpra HTML5
    _pkg -o "xpra xpra-html5" xpra xpra-html5

    # noVNC + websockify (for bc_desktop)
    _pkg -o "novnc python3-websockify" novnc python3-websockify

    # TurboVNC (downloaded RPM — not in repos)
    if rpm -q turbovnc &>/dev/null; then
        print_ok "turbovnc (already installed)"
    else
        local tvnc_rpm="/tmp/turbovnc.rpm"
        local tvnc_url="https://github.com/TurboVNC/turbovnc/releases/download/3.1.2/turbovnc-3.1.2.x86_64.rpm"
        if curl -fL "${tvnc_url}" -o "${tvnc_rpm}" &>>"$LOG_FILE" && \
           rpm -ivh ${DNF_FLAGS_EXTRA:+--nocontexts} "${tvnc_rpm}" &>>"$LOG_FILE"; then
            print_ok "turbovnc"
        else
            print_warn "turbovnc"
        fi
        rm -f "${tvnc_rpm}" 2>/dev/null || true
    fi

    # Enable nodejs:22 and ruby:3.3 AppStream modules (required by ondemand)
    dnf module reset -y nodejs ruby &>>"$LOG_FILE" 2>&1 || true
    dnf module enable -y nodejs:22 ruby:3.3 &>>"$LOG_FILE" 2>&1 || true
    dnf makecache &>>"$LOG_FILE" 2>&1 || true
    print_ok "enable module: nodejs:22 ruby:3.3"

    # Open OnDemand
    _pkg "ondemand" ondemand
}

#-------------------------------------------------------------------------------
# install_code_server: install code-server binary via standalone installer
#-------------------------------------------------------------------------------
install_code_server() {
    log_step "Installing code-server..."
    if [[ -x /opt/code-server/bin/code-server ]]; then
        print_ok "code-server (already installed)"
        return 0
    fi
    if curl -fsSL https://code-server.dev/install.sh | \
            sh -s -- --prefix=/opt/code-server --method=standalone &>>"$LOG_FILE"; then
        print_ok "code-server"
    else
        print_warn "code-server"
    fi
}

#-------------------------------------------------------------------------------
# install_slurm: install Slurm via dnf (EPEL package, skip if already installed)
#-------------------------------------------------------------------------------
install_slurm() {
    if command -v slurmctld &>/dev/null; then
        log_info "Slurm already installed at $(command -v slurmctld). Skipping."
        return 0
    fi

    log_step "Installing Slurm ${SLURM_VERSION} via dnf..."

    _pkg "slurm slurm-slurmctld slurm-slurmd slurm-slurmdbd slurm-contribs slurm-pam_slurm" \
        slurm slurm-slurmctld slurm-slurmd slurm-slurmdbd slurm-contribs slurm-pam_slurm
}

#-------------------------------------------------------------------------------
# setup_slurm_dirs: create required Slurm directories
#-------------------------------------------------------------------------------
setup_slurm_dirs() {
    log_step "Setting up Slurm directories..."
    mkdir -p \
        /etc/slurm \
        /var/spool/slurmd \
        /var/spool/slurmctld \
        /run/slurm \
        /var/lib/slurmd \
        /var/log/slurm \
        /data

    touch \
        /var/lib/slurmd/node_state \
        /var/lib/slurmd/front_end_state \
        /var/lib/slurmd/job_state \
        /var/lib/slurmd/resv_state \
        /var/lib/slurmd/trigger_state \
        /var/lib/slurmd/assoc_mgr_state \
        /var/lib/slurmd/assoc_usage \
        /var/lib/slurmd/qos_usage \
        /var/lib/slurmd/fed_mgr_state

    chown -R slurm:slurm \
        /var/spool/slurmd /var/spool/slurmctld \
        /run/slurm \
        /var/lib/slurmd /var/log/slurm

    # Also fix ownership on legacy spool paths that pre-existing slurm.conf may reference
    for _legacy in /var/spool/slurm /var/spool/slurm/ctld /var/spool/slurm/d; do
        [[ -d "$_legacy" ]] && chown -R slurm:slurm "$_legacy" || true
    done
}

#-------------------------------------------------------------------------------
# setup_munge
#-------------------------------------------------------------------------------
setup_munge() {
    log_step "Setting up Munge authentication..."
    if [[ ! -f /etc/munge/munge.key ]]; then
        /sbin/create-munge-key
    fi
    chown munge:munge /etc/munge/munge.key
    chmod 400 /etc/munge/munge.key
    systemctl enable --now munge
    log_info "Munge ready."
}

#-------------------------------------------------------------------------------
# setup_mariadb: initialise MariaDB and create the slurm accounting database
#-------------------------------------------------------------------------------
setup_mariadb() {
    log_step "Setting up MariaDB..."
    systemctl enable --now mariadb

    # Persist the generated password so idempotent re-runs reuse it
    local pass_file="/etc/slurm/.mariadb_slurm_pass"
    if [[ -f "$pass_file" ]]; then
        MARIADB_SLURM_PASS=$(cat "$pass_file")
    else
        if [[ -z "${MARIADB_SLURM_PASS:-}" ]]; then
            MARIADB_SLURM_PASS="$(openssl rand -base64 24 | tr -d '=+/')"
        fi
        echo "$MARIADB_SLURM_PASS" > "$pass_file"
        chmod 600 "$pass_file"
    fi

    mysql -u root <<SQL
CREATE DATABASE IF NOT EXISTS slurm_acct_db;
CREATE USER IF NOT EXISTS 'slurm'@'localhost' IDENTIFIED BY '${MARIADB_SLURM_PASS}';
GRANT ALL PRIVILEGES ON slurm_acct_db.* TO 'slurm'@'localhost';
FLUSH PRIVILEGES;
SQL
    log_info "MariaDB slurm_acct_db ready."
}

#-------------------------------------------------------------------------------
# Helpers: get_node_name, get_node_info
#-------------------------------------------------------------------------------
get_node_name() {
    local host="$1"
    local my_hostname; my_hostname=$(hostname -s)
    local my_fqdn; my_fqdn=$(hostname -f)
    if [[ "$host" == "localhost" || "$host" == "$my_hostname" || "$host" == "$my_fqdn" ]]; then
        echo "$my_hostname"
    else
        echo "${host%%.*}"
    fi
}

# Outputs: cpus sockets cores_per_socket threads_per_core mem_mb
get_node_info() {
    local host="$1"
    local my_hostname; my_hostname=$(hostname -s)
    local my_fqdn; my_fqdn=$(hostname -f)

    if [[ "$host" == "localhost" || "$host" == "$my_hostname" || "$host" == "$my_fqdn" ]]; then
        local cpus; cpus=$(nproc)
        local sockets; sockets=$(lscpu | awk '/^Socket\(s\):/{print $2}')
        local cores;   cores=$(lscpu | awk '/^Core\(s\) per socket:/{print $4}')
        local threads; threads=$(lscpu | awk '/^Thread\(s\) per core:/{print $4}')
        local mem;     mem=$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo)
        echo "${cpus} ${sockets:-1} ${cores:-$cpus} ${threads:-1} ${mem}"
    else
        local cpus sockets cores threads mem
        cpus=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 root@"$host" nproc 2>/dev/null || echo 4)
        sockets=$(ssh -o StrictHostKeyChecking=no root@"$host" \
            "lscpu | awk '/^Socket\(s\):/{print \$2}'" 2>/dev/null || echo 1)
        cores=$(ssh -o StrictHostKeyChecking=no root@"$host" \
            "lscpu | awk '/^Core\(s\) per socket:/{print \$4}'" 2>/dev/null || echo "$cpus")
        threads=$(ssh -o StrictHostKeyChecking=no root@"$host" \
            "lscpu | awk '/^Thread\(s\) per core:/{print \$4}'" 2>/dev/null || echo 1)
        mem=$(ssh -o StrictHostKeyChecking=no root@"$host" \
            "awk '/^MemTotal:/{print int(\$2/1024)}' /proc/meminfo" 2>/dev/null || echo 4096)
        echo "${cpus} ${sockets} ${cores} ${threads} ${mem}"
    fi
}

#-------------------------------------------------------------------------------
# configure_slurm: write slurm.conf and slurmdbd.conf (skip if already present)
#-------------------------------------------------------------------------------
configure_slurm() {
    log_step "Configuring Slurm..."
    local ctrl_host; ctrl_host=$(hostname -s)
    local ctrl_addr; ctrl_addr=$(hostname -f)
    local cluster_lc; cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')

    if [[ ! -f /etc/slurm/slurm.conf ]]; then
        cat > /etc/slurm/slurm.conf <<EOF
# slurm.conf - generated by hpc-ctl
ClusterName=${cluster_lc}
ControlMachine=${ctrl_host}
ControlAddr=${ctrl_addr}
SlurmUser=slurm
SlurmctldPort=6817
SlurmdPort=6818
AuthType=auth/munge
StateSaveLocation=/var/lib/slurmd
SlurmdSpoolDir=/var/spool/slurmd
SwitchType=switch/none
MpiDefault=none
SlurmctldPidFile=/run/slurm/slurmctld.pid
SlurmdPidFile=/run/slurm/slurmd.pid
ProctrackType=proctrack/linuxproc
ReturnToService=2
DebugFlags=NO_CONF_HASH
Prolog=/usr/local/bin/slurm-prolog.sh
Epilog=/usr/local/bin/slurm-epilog.sh

# TIMERS
SlurmctldTimeout=300
SlurmdTimeout=300
InactiveLimit=0
MinJobAge=300
KillWait=30
Waittime=0

# SCHEDULING
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_CPU

# LOGGING
SlurmctldDebug=info
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdDebug=info
SlurmdLogFile=/var/log/slurm/slurmd.log
JobCompType=jobcomp/filetxt
JobCompLoc=/var/log/slurm/jobcomp.log

# ACCOUNTING
JobAcctGatherType=jobacct_gather/linux
JobAcctGatherFrequency=30
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost=localhost
AccountingStorageEnforce=associations,limits,qos
AccountingStoreFlags=job_comment

# COMPUTE NODES
# (managed by: hpc-ctl cpn -add / cpn -remove / update)

# PARTITIONS
PartitionName=compute Default=yes Nodes=ALL Priority=50 Shared=NO MaxNodes=99 MaxTime=5-00:00:00 DefaultTime=5-00:00:00 State=UP
PartitionName=debug   Nodes=ALL Priority=50 Shared=NO MaxNodes=99 MaxTime=1:00:00 DefaultTime=1:00:00 State=UP
EOF
        log_info "slurm.conf written."
    else
        log_info "slurm.conf already exists; skipping base config."
    fi

    if [[ ! -f /etc/slurm/slurmdbd.conf ]]; then
        cat > /etc/slurm/slurmdbd.conf <<EOF
AuthType=auth/munge
DbdAddr=localhost
DbdHost=localhost
SlurmUser=slurm
DebugLevel=info
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurm/slurmdbd.pid
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser=slurm
StoragePass=${MARIADB_SLURM_PASS}
StorageLoc=slurm_acct_db
EOF
        chmod 600 /etc/slurm/slurmdbd.conf
        chown slurm:slurm /etc/slurm/slurmdbd.conf
        log_info "slurmdbd.conf written."
    else
        log_info "slurmdbd.conf already exists; skipping."
    fi
    # Always enforce correct ownership/permissions on slurmdbd.conf (slurmd runs as slurm user)
    chmod 600 /etc/slurm/slurmdbd.conf
    chown slurm:slurm /etc/slurm/slurmdbd.conf

    # Enforce correct StorageUser/StoragePass in slurmdbd.conf.
    # A pre-existing slurmdbd.conf may have StorageUser=root with a wrong
    # password, preventing slurmdbd from connecting to MariaDB.
    local pass_file="/etc/slurm/.mariadb_slurm_pass"
    if [[ -f /etc/slurm/slurmdbd.conf && -f "$pass_file" ]]; then
        local _pass; _pass=$(cat "$pass_file")
        if ! grep -qE "^StorageUser=slurm$" /etc/slurm/slurmdbd.conf; then
            if grep -qE "^StorageUser=" /etc/slurm/slurmdbd.conf; then
                sed -i -E "s/^StorageUser=.*$/StorageUser=slurm/" /etc/slurm/slurmdbd.conf
            else
                echo "StorageUser=slurm" >> /etc/slurm/slurmdbd.conf
            fi
            log_info "Fixed StorageUser=slurm in slurmdbd.conf"
        fi
        if ! grep -qE "^StoragePass=${_pass}$" /etc/slurm/slurmdbd.conf; then
            if grep -qE "^StoragePass=" /etc/slurm/slurmdbd.conf; then
                sed -i -E "s/^StoragePass=.*$/StoragePass=${_pass}/" /etc/slurm/slurmdbd.conf
            else
                echo "StoragePass=${_pass}" >> /etc/slurm/slurmdbd.conf
            fi
            log_info "Fixed StoragePass in slurmdbd.conf"
        fi
        systemctl restart slurmdbd 2>/dev/null && log_info "slurmdbd restarted." || \
            log_warn "slurmdbd restart failed."
    fi

    # Fix SlurmUser=root → SlurmUser=slurm in existing conf files.
    # slurmdbd validates that its conf is owned by SlurmUser; if SlurmUser=root
    # but the service runs as the slurm OS user the ownership check fails.
    for _conf in /etc/slurm/slurm.conf /etc/slurm/slurmdbd.conf; do
        if [[ -f "$_conf" ]] && grep -q "^SlurmUser=root" "$_conf"; then
            sed -i 's/^SlurmUser=root$/SlurmUser=slurm/' "$_conf"
            log_info "Fixed SlurmUser=root → SlurmUser=slurm in ${_conf}"
        fi
    done

    # Enforce ClusterName and accounting settings in slurm.conf.
    # A default/pre-existing slurm.conf may have ClusterName=cluster and
    # AccountingStorageType=accounting_storage/none, causing sbatch to fail
    # when OOD submits jobs with --cluster=<hpc_cluster_name>.
    if [[ -f /etc/slurm/slurm.conf ]]; then
        # Fix ClusterName
        if ! grep -qE "^ClusterName=${cluster_lc}$" /etc/slurm/slurm.conf; then
            if grep -qE "^ClusterName=" /etc/slurm/slurm.conf; then
                sed -i -E "s/^ClusterName=.*$/ClusterName=${cluster_lc}/" /etc/slurm/slurm.conf
            else
                echo "ClusterName=${cluster_lc}" >> /etc/slurm/slurm.conf
            fi
            log_info "Fixed ClusterName=${cluster_lc} in slurm.conf"
            # Remove stale state file so slurmctld doesn't fatal on cluster name mismatch
            rm -f /var/spool/slurm/ctld/clustername
            log_info "Removed stale clustername state file."
        fi
        # Fix AccountingStorageType
        if ! grep -qE "^AccountingStorageType=accounting_storage/slurmdbd$" /etc/slurm/slurm.conf; then
            if grep -qE "^AccountingStorageType=" /etc/slurm/slurm.conf; then
                sed -i -E "s/^AccountingStorageType=.*$/AccountingStorageType=accounting_storage\/slurmdbd/" /etc/slurm/slurm.conf
            else
                echo "AccountingStorageType=accounting_storage/slurmdbd" >> /etc/slurm/slurm.conf
            fi
            log_info "Fixed AccountingStorageType=accounting_storage/slurmdbd in slurm.conf"
        fi
        # Ensure AccountingStorageHost is set
        if ! grep -qE "^AccountingStorageHost=" /etc/slurm/slurm.conf; then
            echo "AccountingStorageHost=localhost" >> /etc/slurm/slurm.conf
            log_info "Added AccountingStorageHost=localhost to slurm.conf"
        fi
        # Fix SelectType: select/linear allocates whole nodes exclusively,
        # preventing multiple jobs from sharing a node's CPUs.
        # select/cons_tres enables CPU-level resource sharing.
        if ! grep -qE "^SelectType=select/cons_tres$" /etc/slurm/slurm.conf; then
            if grep -qE "^SelectType=" /etc/slurm/slurm.conf; then
                sed -i -E "s/^SelectType=.*$/SelectType=select\/cons_tres/" /etc/slurm/slurm.conf
            else
                echo "SelectType=select/cons_tres" >> /etc/slurm/slurm.conf
            fi
            log_info "Fixed SelectType=select/cons_tres in slurm.conf"
        fi
        if ! grep -qE "^SelectTypeParameters=CR_CPU$" /etc/slurm/slurm.conf; then
            if grep -qE "^SelectTypeParameters=" /etc/slurm/slurm.conf; then
                sed -i -E "s/^SelectTypeParameters=.*$/SelectTypeParameters=CR_CPU/" /etc/slurm/slurm.conf
            else
                echo "SelectTypeParameters=CR_CPU" >> /etc/slurm/slurm.conf
            fi
            log_info "Fixed SelectTypeParameters=CR_CPU in slurm.conf"
        fi
        # Remove DefMemPerCPU from partition lines — CR_CPU (no memory tracking)
        # is used so jobs can consume up to the full node RAM without specifying
        # memory requirements.
        if grep -qE "^PartitionName=.*DefMemPerCPU=" /etc/slurm/slurm.conf; then
            sed -i -E "s/ DefMemPerCPU=[0-9]+//g" /etc/slurm/slurm.conf
            log_info "Removed DefMemPerCPU from partition definitions in slurm.conf"
        fi
    fi

    # Fix partition lines that reference Nodes=localhost.
    # slurmctld fatally exits when a partition names a node that does not exist
    # in NodeName entries; replace localhost with ALL so all registered nodes
    # are included automatically.
    if [[ -f /etc/slurm/slurm.conf ]] && grep -qP "^PartitionName=.*\bNodes=localhost\b" /etc/slurm/slurm.conf; then
        sed -i -E 's/^(PartitionName=.*\b)Nodes=localhost\b/\1Nodes=ALL/' /etc/slurm/slurm.conf
        log_info "Fixed Nodes=localhost → Nodes=ALL in partition definitions in slurm.conf"
    fi

    # Prolog / epilog stubs
    for script in /usr/local/bin/slurm-prolog.sh /usr/local/bin/slurm-epilog.sh; do
        [[ -f "$script" ]] && continue
        printf '#!/bin/bash\nexit 0\n' > "$script"
        chmod +x "$script"
    done
}

#-------------------------------------------------------------------------------
# create_systemd_slurm: install systemd unit files for slurmctld, slurmd, slurmdbd
#-------------------------------------------------------------------------------
create_systemd_slurm() {
    log_step "Creating Slurm systemd unit files..."

    if [[ ! -f /etc/systemd/system/slurmctld.service ]]; then
        cat > /etc/systemd/system/slurmctld.service <<'EOF'
[Unit]
Description=Slurm controller daemon
After=network.target munge.service mariadb.service slurmdbd.service
Requires=munge.service

[Service]
Type=simple
User=slurm
Group=slurm
EnvironmentFile=-/etc/sysconfig/slurm
ExecStart=/usr/sbin/slurmctld -D $SLURMCTLD_OPTIONS
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
LimitNOFILE=65536
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
    fi

    if [[ ! -f /etc/systemd/system/slurmdbd.service ]]; then
        cat > /etc/systemd/system/slurmdbd.service <<'EOF'
[Unit]
Description=Slurm DBD accounting daemon
After=network.target munge.service mariadb.service
Requires=munge.service mariadb.service

[Service]
Type=simple
User=slurm
Group=slurm
EnvironmentFile=-/etc/sysconfig/slurm
ExecStart=/usr/sbin/slurmdbd -D $SLURMDBD_OPTIONS
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
LimitNOFILE=65536
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
    fi

    if [[ ! -f /etc/systemd/system/slurmd.service ]]; then
        cat > /etc/systemd/system/slurmd.service <<'EOF'
[Unit]
Description=Slurm node daemon
After=network.target munge.service slurmctld.service
Requires=munge.service

[Service]
Type=simple
EnvironmentFile=-/etc/sysconfig/slurm
ExecStart=/usr/sbin/slurmd -D $SLURMD_OPTIONS
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
LimitNOFILE=65536
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
    fi

    [[ -f /etc/sysconfig/slurm ]] || echo "# Slurm daemon options" > /etc/sysconfig/slurm
    systemctl daemon-reload
    log_info "Slurm systemd units ready."
}

#-------------------------------------------------------------------------------
# setup_ssl: generate a self-signed cert if none is present
#-------------------------------------------------------------------------------
setup_ssl() {
    log_step "Setting up SSL certificate..."
    if [[ ! -f /etc/pki/tls/certs/ood.crt ]]; then
        openssl req -x509 -nodes -days 3650 -newkey rsa:4096 \
            -keyout /etc/pki/tls/private/ood.key \
            -out    /etc/pki/tls/certs/ood.crt \
            -subj   "/CN=${SERVER_FQDN}" \
            -addext "subjectAltName=DNS:${SERVER_FQDN},DNS:${PROXY_FQDN}"
        chmod 600 /etc/pki/tls/private/ood.key
        log_info "Self-signed SSL certificate generated (replace with a CA-signed cert for production)."
    else
        log_info "SSL certificate already present: /etc/pki/tls/certs/ood.crt"
    fi
}

#-------------------------------------------------------------------------------
# configure_ood: write ood_portal.yml and cluster config
#-------------------------------------------------------------------------------
configure_ood() {
    log_step "Configuring Open OnDemand..."
    local server_hostname; server_hostname=$(hostname -s)
    local server_fqdn;     server_fqdn=$(hostname -f)
    local cluster_lc;      cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')

    mkdir -p \
        /etc/ood/config/clusters.d \
        /etc/ood/config/apps/shell \
        /etc/ood/config/apps/bc_desktop \
        /etc/ood/config/apps/dashboard \
        /etc/ood/config/ondemand.d \
        /var/www/ood/apps/sys

    # Shell app: default SSH host is this server
    cat > /etc/ood/config/apps/shell/env <<EOF
DEFAULT_SSHHOST=${server_hostname}
OOD_DEFAULT_SSHHOST=${server_hostname}
OOD_SSHHOST_ALLOWLIST=${server_hostname}
EOF

    # Dashboard app env: global file-permission defaults (per-user passenger_env_var
    # set by the pun pre-hook takes precedence; these are the dotenv fallbacks)
    local _ood_download _ood_upload
    case "${FILE:-upload}" in
        download) _ood_download=true  ; _ood_upload=true  ;;
        disabled) _ood_download=false ; _ood_upload=false ;;
        *)        _ood_download=false ; _ood_upload=true  ;;  # upload only (default)
    esac
    cat > /etc/ood/config/apps/dashboard/env <<EOF
OOD_BC_CARD_TIME=0
OOD_DOWNLOAD_ENABLED=${_ood_download}
OOD_UPLOAD_ENABLED=${_ood_upload}
EOF

    # Parse OIDC claim and optional regex
    local oidc_claim; oidc_claim=$(echo "${OIDC_REMOTE_USER_CLAIM}" | awk '{print $1}')
    local oidc_regex; oidc_regex=$(echo "${OIDC_REMOTE_USER_CLAIM}" | awk 'NF>1{print $2}')

    # Write ood_portal.yml if it doesn't exist OR if it's the default placeholder
    # (all settings commented out, no active auth: line).  A placeholder causes
    # update_ood_portal to use the no-auth.conf.erb template which hardcodes
    # <VirtualHost *:*> and ignores the port setting entirely.
    local _write_ood_yml=false
    if [[ ! -f /etc/ood/config/ood_portal.yml ]]; then
        _write_ood_yml=true
    elif ! grep -qE "^auth:" /etc/ood/config/ood_portal.yml; then
        log_info "ood_portal.yml is a placeholder (no auth: configured); overwriting."
        _write_ood_yml=true
    fi

    if [[ "$_write_ood_yml" == true ]]; then
        {
            cat <<EOF
---
servername: ${PROXY_FQDN}
port: ${ONDEMAND_PORT}
listen_addr_port: ${ONDEMAND_PORT}
ssl:
  - 'SSLCertificateFile "/etc/pki/tls/certs/ood.crt"'
  - 'SSLCertificateKeyFile "/etc/pki/tls/private/ood.key"'
node_uri: "/node"
rnode_uri: "/rnode"
oidc_uri: "/oidc"
oidc_provider_metadata_url: ${OIDC_PROVIDER_METADATA_URL}
oidc_client_id: ${OIDC_CLIENT_ID}
oidc_client_secret: ${OIDC_CLIENT_SECRET}
oidc_remote_user_claim: ${oidc_claim}
user_map_match: '^([^@]+)'
oidc_scope: "${OIDC_SCOPE}"
EOF
            cat <<EOF
dex_uri: false
auth:
  - 'AuthType openid-connect'
  - 'Require valid-user'
EOF
        } > /etc/ood/config/ood_portal.yml
        # Keep a template for future re-generation
        cp /etc/ood/config/ood_portal.yml /etc/ood/config/ood_portal.yml.tmpl
        log_info "ood_portal.yml written."
    else
        log_info "ood_portal.yml already exists and has auth configured; skipping."
    fi

    # Always enforce user_map_match in ood_portal.yml.
    # oidc_remote_user_claim_regex is not a valid OOD option and is silently
    # ignored; user_map_match is the correct key that strips the @domain suffix
    # before nginx_stage looks up the user, preventing the username mismatch error.
    if [[ -f /etc/ood/config/ood_portal.yml ]]; then
        # Replace the invalid key if present
        if grep -qE "^oidc_remote_user_claim_regex:" /etc/ood/config/ood_portal.yml; then
            sed -i "s/^oidc_remote_user_claim_regex:.*$/user_map_match: '^([^@]+)'/" /etc/ood/config/ood_portal.yml
            log_info "Replaced oidc_remote_user_claim_regex with user_map_match in ood_portal.yml"
        elif ! grep -qE "^user_map_match:" /etc/ood/config/ood_portal.yml; then
            sed -i "s/^oidc_remote_user_claim:.*$/&\nuser_map_match: '^([^@]+)'/" /etc/ood/config/ood_portal.yml
            log_info "Inserted user_map_match into ood_portal.yml"
        fi
    fi

    # Always enforce listen_addr_port in ood_portal.yml.
    # The port: key only sets the VirtualHost binding; listen_addr_port is what
    # adds the Apache Listen directive so httpd actually opens the port.
    if [[ -f /etc/ood/config/ood_portal.yml ]]; then
        if grep -qE "^listen_addr_port:" /etc/ood/config/ood_portal.yml; then
            if ! grep -qE "^listen_addr_port: ${ONDEMAND_PORT}$" /etc/ood/config/ood_portal.yml; then
                sed -i -E "s/^listen_addr_port:.*$/listen_addr_port: ${ONDEMAND_PORT}/" /etc/ood/config/ood_portal.yml
                log_info "Updated listen_addr_port to ${ONDEMAND_PORT} in ood_portal.yml"
            fi
        else
            sed -i "s/^port: /listen_addr_port: ${ONDEMAND_PORT}\nport: /" /etc/ood/config/ood_portal.yml
            log_info "Inserted listen_addr_port: ${ONDEMAND_PORT} into ood_portal.yml"
        fi
    fi

    # Cluster YAML
    if [[ ! -f /etc/ood/config/clusters.d/hpc.yml ]]; then
        cat > /etc/ood/config/clusters.d/hpc.yml <<EOF
---
v2:
  metadata:
    title: "${CLUSTER_NAME}"
  job:
    adapter: "slurm"
    cluster: "${cluster_lc}"
    bin: "/usr/bin"
    conf: "/etc/slurm/slurm.conf"
  batch_connect:
    basic:
      min_port: 40000
      max_port: 65535
    vnc:
      min_port: 40000
      max_port: 65535
EOF
        log_info "clusters.d/hpc.yml written."
    fi

    # Regenerate httpd config from ood_portal.yml.
    # Delete the generated Apache conf first so update_ood_portal always
    # produces a fresh file — otherwise it compares checksums and skips the
    # write (and the httpd restart) when the stale no-auth placeholder matches.
    rm -f /etc/httpd/conf.d/ood-portal.conf
    if /opt/ood/ood-portal-generator/sbin/update_ood_portal 2>/dev/null; then
        log_info "update_ood_portal completed."
    else
        log_warn "update_ood_portal failed; httpd config may need manual refresh."
    fi
    # Restart httpd to pick up the new port/vhost config.
    systemctl restart httpd 2>/dev/null && log_info "httpd restarted." || \
        log_warn "httpd restart failed; check systemctl status httpd."

    # Serve xpra HTML5 static files directly from Apache to avoid 502 errors.
    # Xpra's embedded HTTP server can't handle 30+ parallel browser requests;
    # only the WebSocket upgrade goes through /rnode/ to xpra.
    cat > /etc/httpd/conf.d/xpra-proxy-fix.conf <<'EOF'
Alias /xpra-html5 /usr/share/xpra/www
<Directory /usr/share/xpra/www>
    Options FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>
EOF

    # Raise Apache header size limits to accommodate large OIDC session cookies.
    # The default LimitRequestFieldSize of 8190 bytes is too small for mod_auth_openidc
    # session cookies, causing "Bad Request: request header field exceeds server limit".
    cat > /etc/httpd/conf.d/ood-limits.conf <<'EOF'
LimitRequestFieldSize 65536
LimitRequestLine      65536
EOF

    log_info "Open OnDemand configured."
}

#-------------------------------------------------------------------------------
# setup_sssd: configure SSSD to authenticate against FreeIPA
#-------------------------------------------------------------------------------
setup_sssd() {
    log_step "Configuring SSSD for FreeIPA..."

    if [[ ! -f /etc/sssd/sssd.conf ]]; then
        cat > /etc/sssd/sssd.conf <<EOF
[sssd]
services = nss, pam, ssh
config_file_version = 2
domains = ${IPA_DOMAIN}

[nss]
homedir_substring = /home

[pam]
offline_credentials_expiration = 60

[domain/${IPA_DOMAIN}]
id_provider = ipa
access_provider = ipa
ipa_server = ${IPA_SERVER}
ipa_domain = ${IPA_DOMAIN}
ipa_hostname = $(hostname -f)
auth_provider = ipa
chpass_provider = ipa
ldap_tls_cacert = /etc/ipa/ca.crt
cache_credentials = true
krb5_store_password_if_offline = true
default_shell = /bin/bash
fallback_homedir = /home/%u
full_name_format = %1\$s
EOF
        chmod 600 /etc/sssd/sssd.conf
    else
        log_info "sssd.conf already exists; skipping."
    fi

    # Always enforce full_name_format in sssd.conf.
    # Without it SSSD returns 'user@domain' and OOD's nginx_stage cannot map
    # the username, blocking all user sessions.
    if grep -qE "^full_name_format" /etc/sssd/sssd.conf; then
        if ! grep -qE "^full_name_format = %1\\\$s" /etc/sssd/sssd.conf; then
            sed -i -E "s/^full_name_format.*$/full_name_format = %1\$s/" /etc/sssd/sssd.conf
            log_info "Fixed full_name_format in sssd.conf"
        fi
    else
        echo "full_name_format = %1\$s" >> /etc/sssd/sssd.conf
        log_info "Added full_name_format = %1\$s to sssd.conf"
    fi
    systemctl restart sssd 2>/dev/null && log_info "SSSD restarted." || \
        log_warn "SSSD restart failed."

    systemctl enable --now sssd
    systemctl enable --now oddjobd
    authselect select sssd with-mkhomedir --force 2>/dev/null || true
    log_info "SSSD configured."
}

#-------------------------------------------------------------------------------
# setup_pun_file_hook: per-user OOD file download/upload control
#
# Mechanism:
#   1. A custom pun.conf.erb template adds:
#        include /etc/ood/pun_env/<user>.conf;
#      inside the nginx http block, which sets passenger_env_var for that user.
#   2. A root pre-hook script (run by nginx_stage before each user PUN starts)
#      writes the per-user .conf file based on group membership and hpc.conf FILE.
#   3. /etc/ood/config/apps/dashboard/env (written by configure_ood) provides
#      the dotenv fallback; dotenv load does NOT overwrite passenger_env_var values.
#-------------------------------------------------------------------------------
setup_pun_file_hook() {
    log_step "Configuring per-user OOD file permission hook..."

    # Translate FILE global config to per-user defaults
    local _download_default _upload_default
    case "${FILE:-upload}" in
        download) _download_default=true  ; _upload_default=true  ;;
        disabled) _download_default=false ; _upload_default=false ;;
        *)        _download_default=false ; _upload_default=true  ;;
    esac

    # --- Pre-hook script --------------------------------------------------
    mkdir -p /etc/ood/hooks /etc/ood/pun_env
    cat > /etc/ood/hooks/pun_pre_hook.sh <<EOF
#!/bin/bash
# OOD PUN pre-hook: sets per-user file download/upload permissions.
# Called by nginx_stage as root with: --user <username>
username=""
while [[ \$# -gt 0 ]]; do
    case "\$1" in --user) username="\$2"; shift 2 ;; *) shift ;; esac
done
[[ -z "\$username" ]] && exit 0

mkdir -p /etc/ood/pun_env

# Group membership overrides global defaults from hpc.conf
if id -Gn "\$username" 2>/dev/null | grep -qw "dlp_allow_download"; then
    _download=true
    _upload=true
else
    _download=${_download_default}
    _upload=${_upload_default}
fi

cat > /etc/ood/pun_env/\${username}.conf <<CONFEOF
passenger_env_var OOD_DOWNLOAD_ENABLED \${_download};
passenger_env_var OOD_UPLOAD_ENABLED \${_upload};
CONFEOF
chmod 600 /etc/ood/pun_env/\${username}.conf
EOF
    chmod 755 /etc/ood/hooks/pun_pre_hook.sh
    log_info "Pre-hook script written: /etc/ood/hooks/pun_pre_hook.sh"

    # --- Custom PUN nginx template ----------------------------------------
    # Copy the stock templates; patch only pun.conf.erb to include the
    # per-user passenger_env_var file inside the nginx http block.
    mkdir -p /etc/ood/nginx_stage/templates
    cp /opt/ood/nginx_stage/templates/app.conf.erb \
       /etc/ood/nginx_stage/templates/app.conf.erb
    # Inject include directive right after the passenger_load_shell_envvars line
    sed '/passenger_load_shell_envvars off;/a\  <%- _uenv = "/etc/ood/pun_env/#{user}.conf" -%>\n  <%- if File.exist?(_uenv) -%>\n  include <%= _uenv %>;\n  <%- end -%>' \
        /opt/ood/nginx_stage/templates/pun.conf.erb \
        > /etc/ood/nginx_stage/templates/pun.conf.erb
    log_info "Custom pun.conf.erb written."

    # --- nginx_stage.yml --------------------------------------------------
    local ns_yml=/etc/ood/config/nginx_stage.yml
    # Set pun_pre_hook_root_cmd
    if grep -qE "^pun_pre_hook_root_cmd:" "$ns_yml" 2>/dev/null; then
        sed -i -E "s|^pun_pre_hook_root_cmd:.*|pun_pre_hook_root_cmd: /etc/ood/hooks/pun_pre_hook.sh|" "$ns_yml"
    else
        echo "pun_pre_hook_root_cmd: /etc/ood/hooks/pun_pre_hook.sh" >> "$ns_yml"
    fi
    # Set template_root
    if grep -qE "^template_root:" "$ns_yml" 2>/dev/null; then
        sed -i -E "s|^template_root:.*|template_root: /etc/ood/nginx_stage/templates|" "$ns_yml"
    else
        echo "template_root: /etc/ood/nginx_stage/templates" >> "$ns_yml"
    fi
    log_info "nginx_stage.yml updated."

    log_info "Per-user OOD file hook configured (default: download=${_download_default}, upload=${_upload_default})."
}

#-------------------------------------------------------------------------------
# setup_xpra: configure Xpra HTML5 and create OOD bc_desktop app
#-------------------------------------------------------------------------------
setup_xpra() {
    log_step "Configuring Xpra HTML5 client..."
    local cluster_lc; cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')

    mkdir -p /etc/xpra/html5-client

    # Write default-settings.txt to /etc/xpra/html5-client/ (the conventional
    # config path) and symlink it into the web root so the browser XHR fetch
    # of ./default-settings.txt picks it up.
    cat > /etc/xpra/html5-client/default-settings.txt <<'EOF'
min-quality = 90
min-speed = 10
floating_menu = false

# hide some menus:
xpramenu=false
open_windows=true
fullscreen_button=ture
keyboard_button=false
clipboard_button=false
sound_button=false
cursor_lock_button=false
floating_menu=false
EOF
    ln -sf /etc/xpra/html5-client/default-settings.txt \
        /usr/share/xpra/www/default-settings.txt
    log_info "xpra default-settings.txt written and symlinked."

    if [[ ! -f /etc/xpra/xpra.conf ]]; then
        cat > /etc/xpra/xpra.conf <<'EOF'
# Xpra server defaults for OOD integration
daemon = no
html = /usr/share/xpra/www
encoding = auto
audio = no
clipboard = yes
notifications = no
bell = no
sharing = yes
locks = no
EOF
    fi
    # Always enforce sharing=yes in existing xpra.conf
    if grep -qE "^sharing = no$" /etc/xpra/xpra.conf 2>/dev/null; then
        sed -i 's/^sharing = no$/sharing = yes/' /etc/xpra/xpra.conf
        log_info "Fixed sharing=yes in xpra.conf"
    fi

    # OOD Desktop app (Xfce via Xpra)
    local desktop_dir="/var/www/ood/apps/sys/bc_desktop"
    if [[ ! -d "$desktop_dir" ]]; then
        mkdir -p "$desktop_dir/template"

        cat > "$desktop_dir/manifest.yml" <<'EOF'
---
name: HPC Desktop
category: Interactive Apps
subcategory: Desktops
role: batch_connect
description: Launch an Xfce desktop session on a compute node via TurboVNC + noVNC.
EOF

        cat > "$desktop_dir/form.yml" <<EOF
---
cluster: "${cluster_lc}"
attributes:
  bc_nodelist:
    widget: select
    label: "Compute Node"
    options:
      - ["Any Node (Slurm selects automatically)", ""]
    help: "Select a specific compute node, or let Slurm assign one automatically."

form:
  - bc_num_hours
  - bc_num_slots
  - bc_nodelist
  - bc_email_on_started
EOF

        cat > "$desktop_dir/submit.yml.erb" <<'EOF'
---
batch_connect:
  template: basic
<% unless bc_nodelist.blank? %>
script:
  native:
    - "--nodelist=<%= bc_nodelist %>"
<% end %>
EOF

        cat > "$desktop_dir/template/before.sh.erb" <<'EOF'
# Find a free VNC display by checking lock files, Unix sockets, and abstract sockets
display=1
while [[ -f /tmp/.X${display}-lock ]] || \
      [[ -e /tmp/.X11-unix/X${display} ]] || \
      ss -xlnH 2>/dev/null | grep -q "@/tmp/.X11-unix/X${display}$"; do
    display=$((display + 1))
done
export display
export vnc_port=$((5900 + display))

# Find a free port for websockify (OOD reverse proxy target)
port=$(find_port)

export _vnc_tmp="/var/tmp/vnc-${USER}-${port}"
mkdir -p "${_vnc_tmp}"
export XDG_RUNTIME_DIR="${_vnc_tmp}"
EOF

        cat > "$desktop_dir/template/script.sh.erb" <<'EOF'
#!/usr/bin/env bash

echo "TIMING - Starting TurboVNC desktop at: $(date)"
cd "${HOME}"
set -x

trap '/opt/TurboVNC/bin/vncserver -kill :${display} 2>/dev/null; rm -rf "${_vnc_tmp}"' EXIT

# Create TurboVNC xstartup to launch XFCE
mkdir -p "${HOME}/.vnc"
cat > "${HOME}/.vnc/xstartup.turbovnc" <<'XSTARTUP'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
# Clear saved XFCE sessions to prevent restoring fullscreen/maximized window states
rm -f "${HOME}/.config/xfce4/sessions/xfce4-session."*
exec startxfce4
XSTARTUP
chmod +x "${HOME}/.vnc/xstartup.turbovnc"

# Start TurboVNC (no built-in web server; websockify handles the proxy)
/opt/TurboVNC/bin/vncserver :${display} \
    -securitytypes none \
    -geometry 1920x1080 \
    -depth 24 \
    -xstartup "${HOME}/.vnc/xstartup.turbovnc"

echo "TIMING - TurboVNC started on display :${display} VNC port ${vnc_port} at: $(date)"

# Wait for VNC port to be ready before starting websockify
timeout 30 bash -c "until ss -tln | grep -q :${vnc_port}; do sleep 1; done"

# Start websockify: plain HTTP WebSocket proxy -> VNC port (compatible with OOD rnode proxy)
websockify \
    --web /usr/share/novnc \
    --heartbeat 30 \
    0.0.0.0:${port} \
    localhost:${vnc_port}

echo "TIMING - Desktop exited at: $(date)"
EOF
        chmod +x "$desktop_dir/template/script.sh.erb" \
                 "$desktop_dir/template/before.sh.erb"

        cat > "$desktop_dir/template/after.sh" <<'EOF'
echo "Waiting for websockify to open port ${port}..."
echo "TIMING - Starting wait at: $(date)"
if wait_until_port_used "${host}:${port}" 60; then
    echo "Discovered websockify listening on port ${port}!"
    echo "TIMING - Wait ended at: $(date)"
else
    echo "Timed out waiting for websockify to open port ${port}!"
    echo "TIMING - Wait ended at: $(date)"
    pkill -P ${SCRIPT_PID}
    clean_up 1
fi
sleep 2
EOF
        chmod +x "$desktop_dir/template/after.sh"

        cat > "$desktop_dir/view.html.erb" <<'EOF'
<a href="/rnode/<%= host %>/<%= port %>/vnc.html?autoconnect=true&reconnect=true&resize=remote&path=rnode/<%= host %>/<%= port %>/" target="_blank" class="btn btn-primary">
  <i class="fa fa-desktop"></i> Connect to Desktop
</a>
EOF
        log_info "OOD Desktop (Xfce/TurboVNC/noVNC) app created."
    else
        log_info "bc_desktop app already exists; skipping."
    fi
}

#-------------------------------------------------------------------------------
# setup_interactive_apps: create a unified Applications launcher from apps.conf
#-------------------------------------------------------------------------------
setup_interactive_apps() {
    log_step "Configuring interactive application launchers..."
    local cluster_lc; cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')

    local apps_conf="${CONF_DIR}/apps.conf"
    if [[ ! -f "$apps_conf" ]]; then
        log_warn "apps.conf not found at $apps_conf; skipping app launchers."
        return 0
    fi

    mapfile -t apps < <(grep -v '^\s*#' "$apps_conf" | grep -v '^\s*$' | awk '{print $1}')

    if [[ ${#apps[@]} -eq 0 ]]; then
        log_warn "No apps found in apps.conf; skipping."
        return 0
    fi

    local apps_dir="/var/www/ood/apps/sys"

    # Remove legacy per-app launcher directories
    for app in "${apps[@]}"; do
        local safe_name; safe_name=$(echo "$app" | tr -cd '[:alnum:]_-' | tr '[:upper:]' '[:lower:]')
        local old_dir="${apps_dir}/app_${safe_name}"
        if [[ -d "$old_dir" ]]; then
            rm -rf "$old_dir"
            log_info "Removed legacy per-app launcher: ${old_dir}"
        fi
    done

    # Well-known display name overrides (auto-capitalize fallback for unlisted apps)
    declare -A _label_overrides=(
        ["google-chrome"]="Google Chrome"
        ["gtkwave"]="GTKWave"
        ["libreoffice"]="LibreOffice"
        ["code"]="Visual Studio Code"
        ["xfce4-terminal"]="Xfce4 Terminal"
        ["gnome-terminal"]="GNOME Terminal"
        ["xterm"]="XTerm"
    )

    # Build app options list for form.yml and label map for before.sh.erb title update
    local app_options="" info_labels=""
    for app in "${apps[@]}"; do
        local display_name
        if [[ -n "${_label_overrides[$app]+_}" ]]; then
            display_name="${_label_overrides[$app]}"
        else
            display_name=$(basename "$app" | sed 's/-/ /g; s/\b\(.\)/\u\1/g')
        fi
        app_options+=$'\n'"      - [\"${display_name}\", \"${app}\"]"
        info_labels+=$'\n'"    \"${app}\" => \"${display_name}\","
    done

    local unified_dir="${apps_dir}/app_applications"
    mkdir -p "${unified_dir}/template"

    cat > "${unified_dir}/manifest.yml" <<EOF
---
name: Applications
category: Interactive Apps
subcategory: Applications
role: batch_connect
description: Launch an interactive application on a compute node via Xpra HTML5.
EOF

    cat > "${unified_dir}/form.yml" <<EOF
---
cluster: "${cluster_lc}"
form:
  - app_name
  - bc_num_hours
  - bc_num_slots
  - bc_nodelist
attributes:
  app_name:
    widget: select
    label: "Application"
    options:${app_options}
    help: "Select the application to launch."
  bc_num_hours:
    value: 2
  bc_num_slots:
    value: 1
    max: 4
  bc_nodelist:
    widget: select
    label: "Compute Node"
    options:
      - ["Any Node (Slurm selects automatically)", ""]
    help: "Select a specific compute node."
EOF

    cat > "${unified_dir}/submit.yml.erb" <<'EOF'
---
batch_connect:
  template: basic
<% unless bc_nodelist.blank? %>
script:
  native:
    - "--nodelist=<%= bc_nodelist %>"
<% end %>
EOF

    # Part 1: ERB app label map (bash-interpolated so ${info_labels} is expanded)
    cat > "${unified_dir}/template/before.sh.erb" <<EOF
<%
  _app_labels = {${info_labels}
  }
  _app_label = _app_labels.fetch(context.app_name.to_s, context.app_name.to_s)
%>
EOF
    # Part 2: static bash content (single-quoted to preserve \${USER}, \${port}, etc.)
    cat >> "${unified_dir}/template/before.sh.erb" <<'EOF'
# Find available port for Xpra WebSocket server
port=$(find_port)

# Use a local tmp dir for xpra sockets and Xauthority.
# /home is virtiofs-mounted and xauth file locking fails there (20s timeout).
export _xpra_tmp="/var/tmp/xpra-${USER}-${port}"
mkdir -p "${_xpra_tmp}"
export XAUTHORITY="${_xpra_tmp}/.Xauthority"
export XDG_RUNTIME_DIR="${_xpra_tmp}"

# Update the session card title to show the selected application name
_db_file="${HOME}/ondemand/data/sys/dashboard/batch_connect/db/<%= session.id %>"
if [[ -f "${_db_file}" ]]; then
  python3 -c "
import json, sys
with open(sys.argv[1]) as f: d = json.load(f)
d['title'] = sys.argv[2]
with open(sys.argv[1], 'w') as f: json.dump(d, f)
" "${_db_file}" "<%= _app_label %>" 2>/dev/null || true
fi
EOF

    # Translate global config to xpra values for apps (no group-level overrides)
    local _xpra_clip_default _xpra_xfer_default
    case "${CLIPBOARD:-disabled}" in
        copy)  _xpra_clip_default=yes ;;
        paste) _xpra_clip_default=to-server ;;
        *)     _xpra_clip_default=no ;;
    esac
    case "${FILE:-upload}" in
        download) _xpra_xfer_default=yes ;;
        *)        _xpra_xfer_default=no ;;
    esac

    cat > "${unified_dir}/template/script.sh.erb" <<'EOF'
#!/usr/bin/env bash

echo "TIMING - Starting <%= context.app_name %> via Xpra at: $(date)"
cd "${HOME}"
set -x

trap 'xpra stop "ws:localhost:${port}" 2>/dev/null; sleep 2; pkill -u "${USER}" -f "xpra.*${port}" 2>/dev/null; pkill -u "${USER}" -f "wmctrl.*maximized" 2>/dev/null; rm -rf "${_xpra_tmp}"' EXIT


<% if context.app_name == 'google-chrome' %>
export _app_cmd="google-chrome --no-sandbox --disable-dev-shm-usage --disable-gpu --user-data-dir=/tmp/chrome-\${USER}-\${SLURM_JOB_ID}"
<% elsif context.app_name == 'code' %>
# Pre-create VS Code settings so the window opens maximized
_vscode_dir="/tmp/vscode-\${USER}-\${SLURM_JOB_ID}"
mkdir -p "\${_vscode_dir}/User"
cat > "\${_vscode_dir}/User/settings.json" <<'VSSETTINGS'
{
    "window.newWindowDimensions": "maximized",
    "window.restoreWindows": "none",
    "window.titleBarStyle": "native"
}
VSSETTINGS
export _app_cmd="/usr/share/code/code --no-sandbox --disable-gpu --disable-dev-shm-usage --user-data-dir=\${_vscode_dir}"
<% else %>
export _app_cmd="<%= context.app_name %>"
<% end %>

xpra start \
    --bind-ws=0.0.0.0:${port} \
    --html=on \
    --ws-auth=none \
    --start="openbox --sm-disable" \
    --start="bash -c 'while sleep 1; do wmctrl -l 2>/dev/null | awk \"{print \\\$1}\" | xargs -r -I{} wmctrl -i -r {} -b add,maximized_vert,maximized_horz 2>/dev/null; done'" \
    --start-child="${_app_cmd}" \
    --exit-with-children=yes \
    --daemon=no \
    --socket-dir="${_xpra_tmp}" \
    --pulseaudio=no \
    --notifications=no \
    --webcam=no \
    --system-tray=no \
    --tray=no \
EOF
    # Use printf to avoid bash's \<newline> line-continuation in unquoted heredocs
    printf '    --clipboard=%s \\\n    --file-transfer=%s \\\n' \
        "${_xpra_clip_default}" "${_xpra_xfer_default}" >> "${unified_dir}/template/script.sh.erb"
    cat >> "${unified_dir}/template/script.sh.erb" <<'EOF'
    --sharing=yes \
    --input-method=none \
    --resize-display=1920x1080 \
    --dpi=96 \
    --desktop-scaling=off

echo "TIMING - <%= context.app_name %> exited at: $(date)"
EOF
    chmod +x "${unified_dir}/template/script.sh.erb"

    cat > "${unified_dir}/template/after.sh" <<'EOF'
echo "Waiting for Xpra to open port ${port}..."
if wait_until_port_used "${host}:${port}" 60; then
    echo "Discovered Xpra listening on port ${port}!"
else
    echo "Timed out waiting for Xpra to open port ${port}!"
    pkill -P ${SCRIPT_PID}
    clean_up 1
fi
sleep 5
EOF

    cat > "${unified_dir}/view.html.erb" <<'EOF'
<a href="/xpra-html5/?path=/rnode/<%= host %>/<%= port %>/" target="_blank" class="btn btn-primary">
  <i class="fa fa-desktop"></i> Connect to Application
</a>
EOF

    log_info "Unified Applications launcher created."
}

