    log_info "Slurm systemd units ready."
}

#-------------------------------------------------------------------------------
# setup_ssl: generate a self-signed cert if none is present
#-------------------------------------------------------------------------------
setup_ssl() {
    log_step "Setting up SSL certificate..."
    if [[ ! -f /etc/pki/tls/certs/ood.crt ]]; then
        openssl req -x509 -nodes -days 3650 -newkey rsa:4096 \
            -keyout /etc/pki/tls/private/ood.key \
            -out    /etc/pki/tls/certs/ood.crt \
            -subj   "/CN=${SERVER_FQDN}" \
            -addext "subjectAltName=DNS:${SERVER_FQDN},DNS:${PROXY_FQDN}"
        chmod 600 /etc/pki/tls/private/ood.key
        log_info "Self-signed SSL certificate generated (replace with a CA-signed cert for production)."
    else
        log_info "SSL certificate already present: /etc/pki/tls/certs/ood.crt"
    fi
}

#-------------------------------------------------------------------------------
# configure_ood: write ood_portal.yml and cluster config
#-------------------------------------------------------------------------------
configure_ood() {
    log_step "Configuring Open OnDemand..."
    local server_hostname; server_hostname=$(hostname -s)
    local server_fqdn;     server_fqdn=$(hostname -f)
    local cluster_lc;      cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')

    mkdir -p \
        /etc/ood/config/clusters.d \
        /etc/ood/config/apps/shell \
        /etc/ood/config/apps/bc_desktop \
        /etc/ood/config/apps/dashboard \
        /etc/ood/config/ondemand.d \
        /var/www/ood/apps/sys

    # Shell app: default SSH host is this server
    cat > /etc/ood/config/apps/shell/env <<EOF
DEFAULT_SSHHOST=${server_hostname}
OOD_DEFAULT_SSHHOST=${server_hostname}
OOD_SSHHOST_ALLOWLIST=${server_hostname}
EOF

    # Dashboard app: remove completed session cards immediately (default is 7 days)
    cat > /etc/ood/config/apps/dashboard/env <<EOF
OOD_BC_CARD_TIME=0
EOF

    # Parse OIDC claim and optional regex
    local oidc_claim; oidc_claim=$(echo "${OIDC_REMOTE_USER_CLAIM}" | awk '{print $1}')
    local oidc_regex; oidc_regex=$(echo "${OIDC_REMOTE_USER_CLAIM}" | awk 'NF>1{print $2}')

    if [[ ! -f /etc/ood/config/ood_portal.yml ]]; then
        {
            cat <<EOF
---
servername: ${PROXY_FQDN}
port: ${ONDEMAND_PORT}
ssl:
  - 'SSLCertificateFile "/etc/pki/tls/certs/ood.crt"'
  - 'SSLCertificateKeyFile "/etc/pki/tls/private/ood.key"'
node_uri: "/node"
rnode_uri: "/rnode"
oidc_uri: "/oidc"
oidc_provider_metadata_url: ${OIDC_PROVIDER_METADATA_URL}
oidc_client_id: ${OIDC_CLIENT_ID}
oidc_client_secret: ${OIDC_CLIENT_SECRET}
oidc_remote_user_claim: ${oidc_claim}
EOF
            [[ -n "$oidc_regex" ]] && echo "oidc_remote_user_claim_regex: \"${oidc_regex}\""
            cat <<EOF
oidc_scope: "${OIDC_SCOPE}"
dex_uri: false
auth:
  - 'AuthType openid-connect'
  - 'Require valid-user'
EOF
        } > /etc/ood/config/ood_portal.yml
        # Keep a template for future re-generation
        cp /etc/ood/config/ood_portal.yml /etc/ood/config/ood_portal.yml.tmpl
        log_info "ood_portal.yml written."
    else
        log_info "ood_portal.yml already exists; skipping."
    fi

    # Cluster YAML
    if [[ ! -f /etc/ood/config/clusters.d/hpc.yml ]]; then
        cat > /etc/ood/config/clusters.d/hpc.yml <<EOF
---
v2:
  metadata:
    title: "${CLUSTER_NAME}"
  login:
    host: "${server_fqdn}"
  job:
    adapter: "slurm"
    cluster: "${cluster_lc}"
    bin: "/usr/bin"
    conf: "/etc/slurm/slurm.conf"
  batch_connect:
    basic:
      min_port: 40000
      max_port: 65535
    vnc:
      min_port: 40000
      max_port: 65535
EOF
        log_info "clusters.d/hpc.yml written."
    fi

    # Regenerate httpd config from ood_portal.yml
    /opt/ood/ood-portal-generator/sbin/update_ood_portal 2>/dev/null || \
        log_warn "update_ood_portal failed; httpd config may need manual refresh."

    # Serve xpra HTML5 static files directly from Apache to avoid 502 errors.
    # Xpra's embedded HTTP server can't handle 30+ parallel browser requests;
    # only the WebSocket upgrade goes through /rnode/ to xpra.
    cat > /etc/httpd/conf.d/xpra-proxy-fix.conf <<'EOF'
Alias /xpra-html5 /usr/share/xpra/www
<Directory /usr/share/xpra/www>
    Options None
    AllowOverride None
    Require all granted
</Directory>
EOF

    log_info "Open OnDemand configured."
}

#-------------------------------------------------------------------------------
# setup_sssd: configure SSSD to authenticate against FreeIPA
#-------------------------------------------------------------------------------
setup_sssd() {
    log_step "Configuring SSSD for FreeIPA..."

    if [[ ! -f /etc/sssd/sssd.conf ]]; then
        cat > /etc/sssd/sssd.conf <<EOF
[sssd]
services = nss, pam, ssh
config_file_version = 2
domains = ${IPA_DOMAIN}

[nss]
homedir_substring = /home

[pam]
offline_credentials_expiration = 60

[domain/${IPA_DOMAIN}]
id_provider = ipa
access_provider = ipa
ipa_server = ${IPA_SERVER}
ipa_domain = ${IPA_DOMAIN}
ipa_hostname = $(hostname -f)
auth_provider = ipa
chpass_provider = ipa
ldap_tls_cacert = /etc/ipa/ca.crt
cache_credentials = true
krb5_store_password_if_offline = true
default_shell = /bin/bash
fallback_homedir = /home/%u
EOF
        chmod 600 /etc/sssd/sssd.conf
    else
        log_info "sssd.conf already exists; skipping."
    fi

    systemctl enable --now sssd
    systemctl enable --now oddjobd
    authselect select sssd with-mkhomedir --force 2>/dev/null || true
    log_info "SSSD configured."
}

#-------------------------------------------------------------------------------
# setup_xpra: configure Xpra HTML5 and create OOD bc_desktop app
#-------------------------------------------------------------------------------
setup_xpra() {
    log_step "Configuring Xpra HTML5 client..."
    local cluster_lc; cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')

    mkdir -p /etc/xpra
    if [[ ! -f /etc/xpra/xpra.conf ]]; then
        cat > /etc/xpra/xpra.conf <<'EOF'
# Xpra server defaults for OOD integration
daemon = no
html = /usr/share/xpra/www
encoding = auto
audio = no
clipboard = yes
notifications = no
bell = no
sharing = no
locks = no
EOF
    fi

    # OOD Desktop app (Xfce via Xpra)
    local desktop_dir="/var/www/ood/apps/sys/bc_desktop"
    if [[ ! -d "$desktop_dir" ]]; then
        mkdir -p "$desktop_dir/template"

        cat > "$desktop_dir/manifest.yml" <<'EOF'
---
name: HPC Desktop
category: Interactive Apps
subcategory: Desktops
role: batch_connect
description: Launch an Xfce desktop session on a compute node via Xpra HTML5.
EOF

        cat > "$desktop_dir/form.yml" <<EOF
---
cluster: "${cluster_lc}"
attributes:
  bc_nodelist:
    widget: select
    label: "Compute Node"
    options:
      - ["Any Node (Slurm selects automatically)", ""]
    help: "Select a specific compute node, or let Slurm assign one automatically."

form:
  - bc_num_hours
  - bc_num_slots
  - bc_nodelist
  - bc_email_on_started
EOF

        cat > "$desktop_dir/submit.yml.erb" <<'EOF'
---
batch_connect:
  template: basic
<% unless bc_nodelist.blank? %>
script:
  native:
    - "--nodelist=<%= bc_nodelist %>"
<% end %>
EOF

        cat > "$desktop_dir/template/before.sh.erb" <<'EOF'
# Find available port for Xpra WebSocket server
port=$(find_port)

export _xpra_tmp="/var/tmp/xpra-${USER}-${port}"
mkdir -p "${_xpra_tmp}"
export XAUTHORITY="${_xpra_tmp}/.Xauthority"
export XDG_RUNTIME_DIR="${_xpra_tmp}"
EOF

        cat > "$desktop_dir/template/script.sh.erb" <<'EOF'
#!/usr/bin/env bash

echo "TIMING - Starting Xfce desktop via Xpra at: $(date)"
cd "${HOME}"
set -x

trap 'xpra stop "ws:localhost:${port}" 2>/dev/null; rm -rf "${_xpra_tmp}"' EXIT

xpra start-desktop \
    --bind-ws=0.0.0.0:${port} \
    --html=on \
    --ws-auth=none \
    --start="openbox --sm-disable" \
    --start="xfsettingsd" \
    --start="xfdesktop" \
    --start="xfce4-panel --disable-wm-check" \
    --daemon=no \
    --socket-dir="${_xpra_tmp}" \
    --pulseaudio=no \
    --notifications=no \
    --webcam=no \
    --bell=no \
    --resize-display=yes \
    --dpi=96

echo "TIMING - Desktop exited at: $(date)"
EOF

        cat > "$desktop_dir/template/after.sh" <<'EOF'
echo "Waiting for Xpra to open port ${port}..."
if wait_until_port_used "${host}:${port}" 60; then
    echo "Discovered Xpra listening on port ${port}!"
else
    echo "Timed out waiting for Xpra to open port ${port}!"
    pkill -P ${SCRIPT_PID}
    clean_up 1
fi
sleep 5
EOF

        cat > "$desktop_dir/view.html.erb" <<'EOF'
<a href="/xpra-html5/?path=/rnode/<%= host %>/<%= port %>/&autohide=1" target="_blank" class="btn btn-primary">
  <i class="fa fa-desktop"></i> Connect to Desktop
</a>
EOF
        log_info "OOD Desktop (Xfce/Xpra) app created."
    else
        log_info "bc_desktop app already exists; skipping."
    fi
}

#-------------------------------------------------------------------------------
# setup_interactive_apps: create a unified Applications launcher from apps.conf
#-------------------------------------------------------------------------------
setup_interactive_apps() {
    log_step "Configuring interactive application launchers..."
    local cluster_lc; cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')

    local apps_conf="${CONF_DIR}/apps.conf"
    if [[ ! -f "$apps_conf" ]]; then
        log_warn "apps.conf not found at $apps_conf; skipping app launchers."
        return 0
    fi

    mapfile -t apps < <(grep -v '^\s*#' "$apps_conf" | grep -v '^\s*$' | awk '{print $1}')

    if [[ ${#apps[@]} -eq 0 ]]; then
        log_warn "No apps found in apps.conf; skipping."
        return 0
    fi

    local apps_dir="/var/www/ood/apps/sys"

    # Remove legacy per-app launcher directories
    for app in "${apps[@]}"; do
        local safe_name; safe_name=$(echo "$app" | tr -cd '[:alnum:]_-' | tr '[:upper:]' '[:lower:]')
        local old_dir="${apps_dir}/app_${safe_name}"
        if [[ -d "$old_dir" ]]; then
            rm -rf "$old_dir"
            log_info "Removed legacy per-app launcher: ${old_dir}"
        fi
    done

    # Well-known display name overrides (auto-capitalize fallback for unlisted apps)
    declare -A _label_overrides=(
        ["google-chrome"]="Google Chrome"
        ["gtkwave"]="GTKWave"
        ["libreoffice"]="LibreOffice"
        ["code"]="Visual Studio Code"
        ["xfce4-terminal"]="Xfce4 Terminal"
        ["gnome-terminal"]="GNOME Terminal"
        ["xterm"]="XTerm"
    )

    # Build app options list for form.yml and label map for before.sh.erb title update
    local app_options="" info_labels=""
    for app in "${apps[@]}"; do
        local display_name
        if [[ -n "${_label_overrides[$app]+_}" ]]; then
            display_name="${_label_overrides[$app]}"
        else
            display_name=$(basename "$app" | sed 's/-/ /g; s/\b\(.\)/\u\1/g')
        fi
        app_options+=$'\n'"      - [\"${display_name}\", \"${app}\"]"
        info_labels+=$'\n'"    \"${app}\" => \"${display_name}\","
    done

    local unified_dir="${apps_dir}/app_applications"
    mkdir -p "${unified_dir}/template"

    cat > "${unified_dir}/manifest.yml" <<EOF
---
name: Applications
category: Interactive Apps
subcategory: Applications
role: batch_connect
description: Launch an interactive application on a compute node via Xpra HTML5.
EOF

    cat > "${unified_dir}/form.yml" <<EOF
---
cluster: "${cluster_lc}"
form:
  - app_name
  - bc_num_hours
  - bc_num_slots
  - bc_nodelist
attributes:
  app_name:
    widget: select
    label: "Application"
    options:${app_options}
    help: "Select the application to launch."
  bc_num_hours:
    value: 2
  bc_num_slots:
    value: 1
    max: 4
  bc_nodelist:
    widget: select
    label: "Compute Node"
    options:
      - ["Any Node (Slurm selects automatically)", ""]
    help: "Select a specific compute node."
EOF

    cat > "${unified_dir}/submit.yml.erb" <<'EOF'
---
batch_connect:
  template: basic
<% unless bc_nodelist.blank? %>
script:
  native:
    - "--nodelist=<%= bc_nodelist %>"
<% end %>
EOF

    # Part 1: ERB app label map (bash-interpolated so ${info_labels} is expanded)
    cat > "${unified_dir}/template/before.sh.erb" <<EOF
<%
  _app_labels = {${info_labels}
  }
  _app_label = _app_labels.fetch(context.app_name.to_s, context.app_name.to_s)
%>
EOF
    # Part 2: static bash content (single-quoted to preserve \${USER}, \${port}, etc.)
    cat >> "${unified_dir}/template/before.sh.erb" <<'EOF'
# Find available port for Xpra WebSocket server
port=$(find_port)

# Use a local tmp dir for xpra sockets and Xauthority.
# /home is virtiofs-mounted and xauth file locking fails there (20s timeout).
export _xpra_tmp="/var/tmp/xpra-${USER}-${port}"
mkdir -p "${_xpra_tmp}"
export XAUTHORITY="${_xpra_tmp}/.Xauthority"
export XDG_RUNTIME_DIR="${_xpra_tmp}"

# Update the session card title to show the selected application name
_db_file="${HOME}/ondemand/data/sys/dashboard/batch_connect/db/<%= session.id %>"
if [[ -f "${_db_file}" ]]; then
  python3 -c "
import json, sys
with open(sys.argv[1]) as f: d = json.load(f)
d['title'] = sys.argv[2]
with open(sys.argv[1], 'w') as f: json.dump(d, f)
" "${_db_file}" "<%= _app_label %>" 2>/dev/null || true
fi
EOF

    cat > "${unified_dir}/template/script.sh.erb" <<'EOF'
#!/usr/bin/env bash

echo "TIMING - Starting <%= context.app_name %> via Xpra at: $(date)"
cd "${HOME}"
set -x

trap 'xpra stop "ws:localhost:${port}" 2>/dev/null; rm -rf "${_xpra_tmp}"' EXIT


<% if context.app_name == 'google-chrome' %>
export _app_cmd="google-chrome --no-sandbox --disable-dev-shm-usage --disable-gpu --user-data-dir=/tmp/chrome-\${USER}-\${SLURM_JOB_ID}"
<% elsif context.app_name == 'code' %>
# Pre-create VS Code settings so the window opens maximized
_vscode_dir="/tmp/vscode-\${USER}-\${SLURM_JOB_ID}"
mkdir -p "\${_vscode_dir}/User"
cat > "\${_vscode_dir}/User/settings.json" <<'VSSETTINGS'
{
    "window.newWindowDimensions": "maximized",
    "window.restoreWindows": "none",
    "window.titleBarStyle": "native"
}
VSSETTINGS
export _app_cmd="/usr/share/code/code --no-sandbox --disable-gpu --disable-dev-shm-usage --user-data-dir=\${_vscode_dir}"
<% else %>
export _app_cmd="<%= context.app_name %>"
<% end %>

xpra start \
    --bind-ws=0.0.0.0:${port} \
    --html=on \
    --ws-auth=none \
    --start="openbox --sm-disable" \
    --start="bash -c 'while sleep 1; do wmctrl -l 2>/dev/null | awk \"{print \\\$1}\" | xargs -r -I{} wmctrl -i -r {} -b add,maximized_vert,maximized_horz 2>/dev/null; done'" \
    --start-child="${_app_cmd}" \
    --exit-with-children=yes \
    --daemon=no \
    --socket-dir="${_xpra_tmp}" \
    --pulseaudio=no \
    --notifications=no \
    --webcam=no \
    --resize-display=1920x1080 \
    --dpi=96 \
    --desktop-scaling=off

echo "TIMING - <%= context.app_name %> exited at: $(date)"
EOF
    chmod +x "${unified_dir}/template/script.sh.erb"

    cat > "${unified_dir}/template/after.sh" <<'EOF'
echo "Waiting for Xpra to open port ${port}..."
if wait_until_port_used "${host}:${port}" 60; then
    echo "Discovered Xpra listening on port ${port}!"
else
    echo "Timed out waiting for Xpra to open port ${port}!"
    pkill -P ${SCRIPT_PID}
    clean_up 1
fi
sleep 5
EOF

    cat > "${unified_dir}/view.html.erb" <<'EOF'
<a href="/xpra-html5/?path=/rnode/<%= host %>/<%= port %>/" target="_blank" class="btn btn-primary">
  <i class="fa fa-desktop"></i> Connect to Application
</a>
EOF

    log_info "Unified Applications launcher created."
}

