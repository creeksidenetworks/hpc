cmd_install() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c) CONF_DIR="$2"; shift 2 ;;
            *)  die "Unknown install option: $1. Usage: $0 install [-c <conf_dir>]" ;;
        esac
    done

    check_root
    mkdir -p "$(dirname "$LOG_FILE")"
    : > "$LOG_FILE"
    log_info "=== Open OnDemand HPC install started ==="
    log_info "Config directory : ${CONF_DIR}"
    log_info "Log              : ${LOG_FILE}"

    load_config
    print_config_summary
    disable_selinux
    check_ipa_joined

    setup_slurm_user
    install_repos
    install_packages
    install_code_server
    install_slurm
    setup_slurm_dirs
    setup_munge
    setup_mariadb
    configure_slurm
    create_systemd_slurm
    setup_ssl
    configure_ood
    setup_sssd
    setup_pun_file_hook
    setup_xpra
    setup_interactive_apps
    setup_terminal
    setup_codeserver
    setup_ipa_sync_timer

    # Register this server as the initial compute node
    log_step "Registering this server as the initial compute node..."
    # Remove any stale NodeName=localhost entry; on reinstall the real hostname
    # (e.g. hpc2) is already in slurm.conf, and both localhost + hpc2 resolving
    # to the same host causes "Duplicated NodeHostName" fatal error in slurmctld.
    local _real_hostname; _real_hostname=$(hostname -s)
    if [[ "$_real_hostname" != "localhost" ]] && \
       grep -q "^NodeName=localhost " /etc/slurm/slurm.conf 2>/dev/null; then
        sed -i "/^NodeName=localhost /d" /etc/slurm/slurm.conf
        log_info "Removed stale NodeName=localhost (hostname is ${_real_hostname})."
    fi
    add_node_to_slurm localhost
    update_ood_node_list

    start_services
    setup_firewall
    register_slurm_cluster
    reconfigure_slurm

    echo ""
    log_info "================================================================"
    log_info " Installation complete!"
    log_info " Open OnDemand : https://${PROXY_FQDN}:${ONDEMAND_PORT}"
    log_info " Log file      : ${LOG_FILE}"
    log_info "================================================================"

    cmd_status
}

cmd_cpn_add() {
    local host="${1:-}"
    [[ -z "$host" ]] && die "Usage: $0 cpn -add <hostname|ip>"

    check_root
    load_config

    log_info "Adding compute node: ${host}"
    add_node_to_slurm "$host"
    update_ood_node_list
    reconfigure_slurm

    # Persist to cluster.conf
    local cluster_conf="${CONF_DIR}/cluster.conf"
    local node_name; node_name=$(get_node_name "$host")
    if [[ -f "$cluster_conf" ]] && ! grep -qE "^(${host}|${node_name})([[:space:]]|$)" "$cluster_conf"; then
        echo "$host" >> "$cluster_conf"
        log_info "Appended '$host' to ${cluster_conf}"
    fi

    log_info "Node '${host}' added successfully."
}

cmd_cpn_remove() {
    local host="${1:-}"
    [[ -z "$host" ]] && die "Usage: $0 cpn -remove <hostname|ip>"

    check_root
    load_config

    log_info "Removing compute node: ${host}"
    remove_node_from_slurm "$host"
    update_ood_node_list
    reconfigure_slurm

    # Remove from cluster.conf
    local cluster_conf="${CONF_DIR}/cluster.conf"
    local node_name; node_name=$(get_node_name "$host")
    if [[ -f "$cluster_conf" ]]; then
        sed -i "/^${host}\([[:space:]]\|$\)/d; /^${node_name}\([[:space:]]\|$\)/d" "$cluster_conf"
        log_info "Removed '${host}' from ${cluster_conf}"
    fi

    log_info "Node '${host}' removed successfully."
}

cmd_update() {
    check_root
    load_config

    setup_mariadb
    configure_slurm
    configure_ood
    setup_sssd
    setup_pun_file_hook
    setup_xpra
    setup_interactive_apps
    setup_terminal
    setup_codeserver
    register_slurm_cluster

    local cluster_conf="${CONF_DIR}/cluster.conf"
    [[ ! -f "$cluster_conf" ]] && die "cluster.conf not found: ${cluster_conf}"

    log_step "Syncing cluster nodes from ${cluster_conf}..."

    # Desired nodes
    mapfile -t desired_hosts < <(grep -v '^\s*#' "$cluster_conf" | grep -v '^\s*$' | awk '{print $1}')
    local desired_names=()
    for h in "${desired_hosts[@]}"; do desired_names+=("$(get_node_name "$h")"); done

    # Current nodes in slurm.conf
    mapfile -t current_names < <(grep "^NodeName=" /etc/slurm/slurm.conf 2>/dev/null | grep -oP 'NodeName=\K\S+')

    # Add missing nodes
    for i in "${!desired_hosts[@]}"; do
        local h="${desired_hosts[$i]}"
        local n="${desired_names[$i]}"
        if ! printf '%s\n' "${current_names[@]}" | grep -q "^${n}$"; then
            log_info "Adding missing node: ${h}"
            add_node_to_slurm "$h"
        else
            log_info "Node already present: ${n}"
        fi
    done

    # Remove nodes no longer in cluster.conf
    for n in "${current_names[@]}"; do
        if ! printf '%s\n' "${desired_names[@]}" | grep -q "^${n}$"; then
            log_info "Removing stale node: ${n}"
            remove_node_from_slurm "$n"
        fi
    done

    update_ood_node_list
    reconfigure_slurm
    log_info "Cluster update complete."
}

#-------------------------------------------------------------------------------
# cmd_status: show health of all HPC services, Slurm nodes, and OOD apps
#-------------------------------------------------------------------------------
cmd_status() {
    echo ""
    echo -e "${Cyan}$(printf '═%.0s' $(seq 1 50))${Reset}"
    echo -e "${Cyan}║${Reset}  ${Bold}HPC System Status${Reset}"
    echo -e "${Cyan}$(printf '═%.0s' $(seq 1 50))${Reset}"
    echo ""

    # --- Services ---
    echo -e "${Bold}Services:${Reset}"
    local services=(mariadb munge slurmdbd slurmctld slurmd httpd crond sshd)
    for svc in "${services[@]}"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            printf "  ${Green}✓${Reset} %-20s active\n" "$svc"
        elif systemctl list-unit-files --quiet "${svc}.service" 2>/dev/null | grep -q "$svc"; then
            printf "  ${Red}✗${Reset} %-20s INACTIVE\n" "$svc"
        else
            printf "  ${Yellow}⚠${Reset} %-20s not installed\n" "$svc"
        fi
    done

    # --- Slurm nodes ---
    echo ""
    echo -e "${Bold}Slurm Nodes:${Reset}"
    if command -v sinfo &>/dev/null; then
        sinfo --noheader 2>/dev/null | sed 's/^/  /' || \
            echo "  (sinfo unavailable — is slurmctld running?)"
    else
        echo "  Slurm not installed"
    fi

    # --- Active jobs ---
    echo ""
    echo -e "${Bold}Active Jobs:${Reset}"
    if command -v squeue &>/dev/null; then
        local job_count
        job_count=$(squeue --noheader 2>/dev/null | wc -l)
        if [[ "$job_count" -gt 0 ]]; then
            squeue --noheader 2>/dev/null | sed 's/^/  /'
        else
            echo "  No active jobs"
        fi
    else
        echo "  Slurm not installed"
    fi

    # --- OOD apps ---
    echo ""
    echo -e "${Bold}OOD Interactive Apps:${Reset}"
    local apps_dir="/var/www/ood/apps/sys"
    local app_dirs=(bc_desktop app_terminal app_codeserver app_applications)
    for app in "${app_dirs[@]}"; do
        if [[ -d "${apps_dir}/${app}" ]]; then
            local name; name=$(grep "^name:" "${apps_dir}/${app}/manifest.yml" 2>/dev/null | awk '{$1=""; print $0}' | xargs)
            printf "  ${Green}✓${Reset} %-20s %s\n" "$app" "${name}"
        else
            printf "  ${Red}✗${Reset} %-20s missing\n" "$app"
        fi
    done

    # --- Tools ---
    echo ""
    echo -e "${Bold}Tools:${Reset}"
    for tool in xpra code-server libreoffice gtkwave google-chrome xfce4-terminal gnome-terminal; do
        local found=false
        if [[ "$tool" == "code-server" ]]; then
            [[ -x /opt/code-server/bin/code-server ]] && found=true
        elif command -v "$tool" &>/dev/null; then
            found=true
        fi
        if $found; then
            printf "  ${Green}✓${Reset} %s\n" "$tool"
        else
            printf "  ${Red}✗${Reset} %s NOT FOUND\n" "$tool"
        fi
    done

    echo ""
}

#===============================================================================
# MAIN
#===============================================================================
main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi

    local cmd="$1"; shift
    case "$cmd" in
        install)
            cmd_install "$@"
            ;;
        cpn)
            local sub="${1:-}"
            shift
            case "$sub" in
                -add)    cmd_cpn_add "$@" ;;
                -remove) cmd_cpn_remove "$@" ;;
                *)       die "Unknown cpn subcommand: '${sub}'. Use -add or -remove." ;;
            esac
            ;;
        update)
            cmd_update "$@"
            ;;
        restart)
            cmd_restart
            ;;
        status)
            cmd_status
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            die "Unknown command: '${cmd}'. Run '$0 --help' for usage."
            ;;
    esac
}

main "$@"
