#-------------------------------------------------------------------------------
# setup_codeserver: create OOD app_codeserver (web-based VS Code, group-gated)
#-------------------------------------------------------------------------------
setup_codeserver() {
    log_step "Configuring VS Code (code-server) app..."
    local cluster_lc; cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')
    local dir="/var/www/ood/apps/sys/app_codeserver"
    mkdir -p "${dir}/template"

    # Restrict app visibility: OOD PUN runs as the user, so non-members of
    # app_codeserver cannot read this directory and the app won't appear for them.
    if getent group app_codeserver &>/dev/null; then
        chgrp app_codeserver "${dir}"
        chmod 750 "${dir}"
    fi

    cat > "${dir}/manifest.yml" <<'EOF'
---
name: Code Server
category: Interactive Apps
subcategory: Development
role: batch_connect
description: >
  Launch Visual Studio Code (code-server) in the browser on a compute node.
  Requires membership in the app_codeserver group.
EOF

    cat > "${dir}/form.yml" <<EOF
---
cluster: "${cluster_lc}"
form:
  - bc_num_hours
  - bc_num_slots
  - bc_nodelist
attributes:
  bc_num_hours:
    value: 4
  bc_num_slots:
    value: 2
    max: 8
  bc_nodelist:
    widget: select
    label: "Compute Node"
    options:
      - ["Any Node (Slurm selects automatically)", ""]
    help: "Select a specific compute node, or let Slurm assign one automatically."
EOF

    cat > "${dir}/submit.yml.erb" <<'EOF'
---
batch_connect:
  template: basic
<% unless bc_nodelist.blank? %>
script:
  native:
    - "--nodelist=<%= bc_nodelist %>"
<% end %>
EOF

    cat > "${dir}/template/before.sh.erb" <<'EOF'
# Group access check — requires app_codeserver group membership
if getent group app_codeserver &>/dev/null && ! getent group app_codeserver | grep -qw "$USER"; then
  echo "============================================================"
  echo "ACCESS DENIED: You must be a member of the 'app_codeserver'"
  echo "group to use the VS Code (code-server) app."
  echo "Contact your HPC administrator to request access."
  echo "============================================================"
  exit 1
fi

# Find available port for code-server
port=$(find_port)

export _cs_local="/var/tmp/code-server-${USER}-${port}"
mkdir -p "${_cs_local}/user-data" "${_cs_local}/extensions"

# Write code-server config
mkdir -p "${HOME}/.config/code-server"
cat > "${HOME}/.config/code-server/config.yaml" <<EOL
bind-addr: 0.0.0.0:${port}
auth: none
disable-telemetry: true
EOL
EOF

    cat > "${dir}/template/script.sh.erb" <<'EOF'
#!/usr/bin/env bash

echo "TIMING - Starting code-server at: $(date)"
cd "${HOME}"
set -x

trap 'rm -rf "${_cs_local}"' EXIT

/opt/code-server/bin/code-server \
    --config "${HOME}/.config/code-server/config.yaml" \
    --user-data-dir "${_cs_local}/user-data" \
    --extensions-dir "${_cs_local}/extensions" \
    "${HOME}"

echo "TIMING - code-server exited at: $(date)"
EOF

    cat > "${dir}/template/after.sh" <<'EOF'
echo "Waiting for code-server to open port ${port}..."
echo "TIMING - Starting wait at: $(date)"
if wait_until_port_used "${host}:${port}" 60; then
    echo "Discovered code-server listening on port ${port}!"
    echo "TIMING - Wait ended at: $(date)"
else
    echo "Timed out waiting for code-server to open port ${port}!"
    pkill -P ${SCRIPT_PID}
    clean_up 1
fi
sleep 2
EOF

    cat > "${dir}/view.html.erb" <<'EOF'
<a href="/rnode/<%= host %>/<%= port %>/" target="_blank" class="btn btn-primary">
  <i class="fa fa-code"></i> Connect to VS Code
</a>
EOF

    chmod +x "${dir}/template/script.sh.erb" "${dir}/template/before.sh.erb" "${dir}/template/after.sh"
    log_info "VS Code (code-server) app created."
}

#-------------------------------------------------------------------------------
# setup_ipa_sync_timer: systemd timer that runs sync-slurm-ipa.sh every 10 min
#-------------------------------------------------------------------------------
setup_ipa_sync_timer() {
    log_step "Setting up IPA-Slurm sync timer (every 10 minutes)..."

    # Install the sync script
    local sync_dst="/usr/local/bin/sync-slurm-ipa.sh"
    local sync_src="${SCRIPT_DIR}/scripts/sync-slurm-ipa.sh"
    if [[ -f "$sync_src" ]]; then
        cp "$sync_src" "$sync_dst"
    else
        log_warn "sync-slurm-ipa.sh not found at ${sync_src}; installing a stub."
        cat > "$sync_dst" <<'EOF'
#!/bin/bash
# IPA -> Slurm user sync stub
# Replace with the real sync-slurm-ipa.sh from ./scripts/
echo "$(date): sync-slurm-ipa.sh: not yet configured"
exit 0
EOF
    fi
    chmod +x "$sync_dst"

    # Write IPA credentials for the sync script
    mkdir -p /etc/hpc
    cat > /etc/hpc/ipa.conf <<EOF
IPA_SERVER=${IPA_SERVER}
IPA_DOMAIN=${IPA_DOMAIN}
IPA_BASE_DN=${IPA_BASE_DN}
IPA_USER_BASE=${IPA_USER_BASE}
IPA_GROUP_BASE=${IPA_GROUP_BASE}
IPA_BIND_DN=${IPA_BIND_DN:-}
IPA_BIND_PASSWORD=${IPA_BIND_PASSWORD:-}
IPA_HPC_GROUP=${IPA_HPC_GROUP}
EOF
    chmod 600 /etc/hpc/ipa.conf

    # Patch script to use /etc/hpc/ipa.conf instead of the Docker path
    sed -i 's|/config/ipa/ipa.conf|/etc/hpc/ipa.conf|g' "$sync_dst" 2>/dev/null || true

    # Systemd one-shot service
    cat > /etc/systemd/system/sync-slurm-ipa.service <<EOF
[Unit]
Description=Sync FreeIPA users to Slurm accounting
After=network.target sssd.service slurmctld.service

[Service]
Type=oneshot
ExecStart=${sync_dst}
StandardOutput=append:/var/log/sync-slurm-ipa.log
StandardError=append:/var/log/sync-slurm-ipa.log
EOF

    # Systemd timer - every 10 minutes
    cat > /etc/systemd/system/sync-slurm-ipa.timer <<'EOF'
[Unit]
Description=Run IPA-Slurm sync every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
Unit=sync-slurm-ipa.service

[Install]
WantedBy=timers.target
EOF

    systemctl daemon-reload
    systemctl enable --now sync-slurm-ipa.timer
    log_info "sync-slurm-ipa.timer enabled."
}

#-------------------------------------------------------------------------------
# add_node_to_slurm: insert a NodeName line into slurm.conf
#-------------------------------------------------------------------------------
add_node_to_slurm() {
    local host="$1"
    local node_name; node_name=$(get_node_name "$host")

    if grep -q "^NodeName=${node_name} " /etc/slurm/slurm.conf 2>/dev/null; then
        log_warn "Node '${node_name}' already exists in slurm.conf."
        return 0
    fi

    log_info "Detecting hardware for node: ${host}"
    read -r cpus sockets cores threads mem <<< "$(get_node_info "$host")"

    local node_addr
    if [[ "$host" == "localhost" || "$host" == "$(hostname -s)" || "$host" == "$(hostname -f)" ]]; then
        node_addr=$(hostname -I | awk '{print $1}')
    else
        node_addr="$host"
    fi

    local node_line="NodeName=${node_name} NodeAddr=${node_addr} CPUs=${cpus} Sockets=${sockets} CoresPerSocket=${cores} ThreadsPerCore=${threads} RealMemory=${mem} State=UNKNOWN"

    if grep -q "^# PARTITIONS" /etc/slurm/slurm.conf 2>/dev/null; then
        sed -i "/^# PARTITIONS/i ${node_line}" /etc/slurm/slurm.conf
    else
        echo "$node_line" >> /etc/slurm/slurm.conf
    fi
    log_info "Added to slurm.conf: ${node_line}"
}

#-------------------------------------------------------------------------------
# remove_node_from_slurm: delete a NodeName line from slurm.conf
#-------------------------------------------------------------------------------
remove_node_from_slurm() {
    local host="$1"
    local node_name; node_name=$(get_node_name "$host")

    if ! grep -q "^NodeName=${node_name} " /etc/slurm/slurm.conf 2>/dev/null; then
        log_warn "Node '${node_name}' not found in slurm.conf."
        return 0
    fi

    sed -i "/^NodeName=${node_name} /d" /etc/slurm/slurm.conf
    log_info "Removed node '${node_name}' from slurm.conf."
}

#-------------------------------------------------------------------------------
# update_ood_node_list: refresh bc_nodelist options in all OOD form.yml files
#-------------------------------------------------------------------------------
update_ood_node_list() {
    log_step "Updating OOD interactive app node lists..."

    # Build the new options list from slurm.conf
    local opts
    opts='      - ["Any Node (Slurm selects automatically)", ""]'
    while IFS= read -r line; do
        local name; name=$(echo "$line" | grep -oP 'NodeName=\K\S+')
        local addr; addr=$(echo "$line" | grep -oP 'NodeAddr=\K\S+')
        [[ -n "$name" ]] && opts+=$'\n'"      - [\"${name} (${addr})\", \"${name}\"]"
    done < <(grep "^NodeName=" /etc/slurm/slurm.conf 2>/dev/null)

    # Update every form.yml that has a bc_nodelist section
    while IFS= read -r form_file; do
        grep -q 'bc_nodelist' "$form_file" || continue
        python3 - "$form_file" <<PYEOF
import sys, re

form_file = sys.argv[1]
new_options = """${opts}"""

with open(form_file) as f:
    content = f.read()

# Replace options block under bc_nodelist
pattern = r'(  bc_nodelist:.*?options:\n)((?:      - .*\n)*)'
replacement = r'\1' + new_options + '\n'
new_content = re.sub(pattern, replacement, content, flags=re.DOTALL)

with open(form_file, 'w') as f:
    f.write(new_content)
PYEOF
        log_info "Updated node list in: ${form_file}"
    done < <(find /var/www/ood/apps/sys -name "form.yml" 2>/dev/null)
}

#-------------------------------------------------------------------------------
# reconfigure_slurm: reload slurmctld after config changes
#-------------------------------------------------------------------------------
reconfigure_slurm() {
    log_step "Reconfiguring Slurm..."
    if systemctl is-active slurmctld &>/dev/null; then
        scontrol reconfigure && log_info "Slurm reconfigured." || \
            log_warn "scontrol reconfigure failed; restart slurmctld manually."
    else
        log_warn "slurmctld is not running; skipping reconfigure."
    fi
}

#-------------------------------------------------------------------------------
# register_slurm_cluster: ensure the cluster is registered in slurmdbd
#-------------------------------------------------------------------------------
register_slurm_cluster() {
    local cluster_lc; cluster_lc=$(echo "${CLUSTER_NAME}" | tr '[:upper:]' '[:lower:]')
    log_step "Registering cluster '${cluster_lc}' in Slurm accounting database..."

    if ! systemctl is-active --quiet slurmdbd; then
        log_warn "slurmdbd is not running; skipping cluster registration."
        return
    fi

    # Wait briefly for slurmdbd to be ready
    local retries=6
    while (( retries-- > 0 )); do
        sacctmgr list cluster name="${cluster_lc}" --noheader 2>/dev/null | grep -q "${cluster_lc}" && break
        sacctmgr list cluster --noheader 2>/dev/null | grep -q "${cluster_lc}" && break
        sleep 2
    done

    if sacctmgr list cluster --noheader 2>/dev/null | grep -q "${cluster_lc}"; then
        log_info "Cluster '${cluster_lc}' already registered in accounting database."
    else
        sacctmgr add cluster "${cluster_lc}" -i 2>&1 | \
            while IFS= read -r line; do log_info "sacctmgr: $line"; done
        log_info "Cluster '${cluster_lc}' registered."
    fi

    # Restart slurmctld so it connects to slurmdbd and populates ControlHost/Port.
    # Without this, sbatch --cluster=<name> fails even though the cluster is registered.
    systemctl restart slurmctld 2>/dev/null && log_info "slurmctld restarted." || \
        log_warn "slurmctld restart failed."
}

#-------------------------------------------------------------------------------
# start_services: enable and start all core services
#-------------------------------------------------------------------------------
setup_firewall() {
    log_step "Opening firewall ports for httpd and Slurm..."
    if ! command -v firewall-cmd &>/dev/null; then
        log_warn "firewall-cmd not found — skipping firewall configuration"
        return
    fi
    if ! systemctl is-active --quiet firewalld; then
        log_warn "firewalld is not running — skipping firewall configuration"
        return
    fi

    local ports=(
        "${ONDEMAND_PORT:-8443}/tcp"   # httpd / Open OnDemand
        "6817/tcp"                      # slurmctld
        "6818/tcp"                      # slurmd
    )
    for port in "${ports[@]}"; do
        if firewall-cmd --query-port="$port" --permanent &>/dev/null; then
            log_info "Port already open: $port"
        else
            firewall-cmd --add-port="$port" --permanent && log_info "Opened port: $port" || \
                log_warn "Failed to open port: $port"
        fi
    done
    firewall-cmd --reload && log_info "Firewall reloaded" || log_warn "Firewall reload failed"
}

start_services() {
    log_step "Enabling and starting services..."

    # Enable all services first
    local services=(mariadb munge slurmdbd slurmctld slurmd httpd crond sshd)
    for svc in "${services[@]}"; do
        systemctl enable "$svc" 2>/dev/null && log_info "Enabled: $svc" || true
    done

    # Start non-slurm services
    for svc in mariadb munge httpd crond sshd; do
        systemctl start "$svc" 2>/dev/null && log_info "Started: $svc" || \
            log_warn "Failed to start: $svc"
    done

    # Start slurm services in dependency order with delays for initialization
    local _slurm_start
    _slurm_start() {
        local svc="$1" delay="${2:-3}"
        systemctl start "$svc" 2>/dev/null; sleep "$delay"
        if systemctl is-active --quiet "$svc"; then
            log_info "Started: $svc"
        else
            log_warn "Failed to start: $svc"
        fi
    }
    _slurm_start slurmdbd 3
    _slurm_start slurmctld 2
    _slurm_start slurmd 1
}

#-------------------------------------------------------------------------------
# cmd_restart: restart all HPC services and kill user PUNs for OOD refresh
#-------------------------------------------------------------------------------
cmd_restart() {
    check_root
    log_step "Stopping Slurm services (ordered)..."
    # Stop in reverse dependency order
    for svc in slurmd slurmctld slurmdbd; do
        systemctl stop "$svc" 2>/dev/null && log_info "Stopped: $svc" || true
    done

    log_step "Restarting base services..."
    for svc in mariadb munge httpd crond sshd; do
        systemctl restart "$svc" && log_info "Restarted: $svc" || \
            log_warn "Failed to restart: $svc"
    done

    log_step "Starting Slurm services (ordered)..."
    # Start in dependency order; use is-active check because Type=forking PID timing
    # can cause systemctl start to return non-zero even when daemon starts successfully
    slurm_start() {
        local svc="$1" delay="${2:-3}"
        systemctl start "$svc" 2>/dev/null; sleep "$delay"
        if systemctl is-active --quiet "$svc"; then
            log_info "Started: $svc"
        else
            log_warn "Failed to start: $svc"
        fi
    }
    slurm_start slurmdbd 3
    slurm_start slurmctld 2
    slurm_start slurmd 1

    log_step "Stopping all user PUNs (OOD will restart them on next page load)..."
    /opt/ood/nginx_stage/sbin/nginx_stage nginx_list 2>/dev/null | while read -r user; do
        /opt/ood/nginx_stage/sbin/nginx_stage nginx --user "$user" --signal stop 2>/dev/null && \
            log_info "Stopped PUN for: $user" || true
    done

    log_info "Restart complete. Users will get a fresh OOD session on next page load."
}

