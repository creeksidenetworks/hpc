# sssd.conf — SSSD LDAP configuration for FreeIPA
# File must be owned by root, mode 0600
#
# Uses id_provider=ldap (not ipa) — no Kerberos keytab required.
# Suitable for containers that are NOT enrolled via ipa-client-install.
#
# For PAM auth (mod_authnz_pam on port 443):
#   SSSD does a simple LDAP bind as the user to verify their password.
#   The service account (ldap_default_bind_dn) is used only for user lookups.

[sssd]
services             = nss, pam
domains              = csn.corp
config_file_version  = 2

[domain/csn.corp]
id_provider          = ldap
auth_provider        = ldap
access_provider      = permit
chpass_provider      = none

# ---- LDAP connection ----
ldap_uri             = ldaps://ipa1.csn.corp
ldap_search_base     = dc=csn,dc=corp

# ---- FreeIPA LDAP schema ----
ldap_schema                 = rfc2307bis
ldap_user_search_base       = cn=users,cn=accounts,dc=csn,dc=corp
ldap_group_search_base      = cn=groups,cn=accounts,dc=csn,dc=corp
ldap_user_object_class      = posixAccount
ldap_group_object_class     = posixGroup
ldap_user_name              = uid
ldap_user_uid_number        = uidNumber
ldap_user_gid_number        = gidNumber
ldap_user_home_directory    = homeDirectory
ldap_user_shell             = loginShell
ldap_user_fullname          = cn

# ---- Service account for user lookups ----
# Required if IPA restricts anonymous LDAP reads (default in IPA 4.x+).
ldap_default_bind_dn        = uid=ldapauth,cn=sysaccounts,cn=etc,dc=csn,dc=corp
ldap_default_authtok_type   = password
ldap_default_authtok        = CHANGE_ME_BIND_PASSWORD

# ---- TLS ----
ldap_tls_reqcert     = demand
ldap_tls_cacert      = /etc/ipa/ca.crt

# ---- Home directory ----
override_homedir     = /home/%u

# ---- Caching ----
cache_credentials    = True
enumerate            = False

# ---- Logging (increase to 7 for troubleshooting) ----
debug_level          = 0
