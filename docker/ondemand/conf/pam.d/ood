# /etc/pam.d/ood — PAM configuration for Open OnDemand local auth
# Used by mod_authnz_pam to authenticate IPA users via SSSD.
#
# Explicitly calls pam_sss.so because containers do not run authselect,
# so the system password-auth stack only has pam_unix.so (local accounts).

auth        required      pam_env.so
auth        sufficient    pam_unix.so try_first_pass nullok
auth        sufficient    pam_sss.so  use_first_pass
auth        required      pam_deny.so

account     required      pam_unix.so
account     [default=bad success=ok user_unknown=ignore] pam_sss.so
account     required      pam_permit.so
# Run provisioning script on every login (background, non-blocking).
# Cooldown inside the script limits full work to once per hour.
account     optional      pam_exec.so quiet --background /usr/local/bin/ood-pun-setup.sh

session     required      pam_limits.so
session     optional      pam_mkhomedir.so skel=/etc/skel umask=0077
