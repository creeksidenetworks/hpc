# .env — MariaDB credentials for docker-compose
# Copy to .env and replace CHANGE_ME values.
# build.sh will auto-generate random passwords on first run if CHANGE_ME is present.
# NEVER commit .env to version control.

MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_SLURM_PASSWORD=CHANGE_ME_SLURM_PASSWORD
